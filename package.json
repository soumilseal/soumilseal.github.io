{
  "name": "soumil-seal-portfolio",
  "version": "1.0.0",
  "description": "Personal Portfolio and Editorial Blog of Soumil Seal - Developer & BCA Student",
  "author": "Soumil Seal",
  "license": "MIT",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n \"11ty,tailwind\" -c \"cyan,magenta\" \"eleventy --serve\" \"tailwindcss -i ./src/assets/css/main.css -o ./_site/assets/css/main.css --watch\"",
    "build:eleventy": "eleventy",
    "build:css": "tailwindcss -i ./src/assets/css/main.css -o ./_site/assets/css/main.css --minify",
    "build:pagefind": "pagefind --site _site",
    "build": "npm run build:eleventy && npm run build:css && npm run build:pagefind"
  },
  "keywords": [
    "eleventy",
    "portfolio",
    "blog",
    "tailwind",
    "preline",
    "pagefind"
  ],
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.20",
    "bootstrap-icons": "^1.13.2",
    "concurrently": "^9.1.2",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pagefind": "^1.3.0",
    "postcss": "^8.4.49",
    "preline": "^5.0.0",
    "prismjs": "^1.29.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}