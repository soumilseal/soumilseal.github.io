---
layout: layouts/page.njk
title: Writing
description: Technical articles, system design explorations, and engineering notes on modern software development and cloud systems.
permalink: /blog/
---
{% import "components/icons.njk" as icons %}

<div class="space-y-10">

  <!-- Filter & Search Bar -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pb-4 border-b border-neutral-200/60 dark:border-neutral-800/60">
    <!-- Topic Tags -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
      <a href="/blog/" class="px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 transition-colors">
        All ({{ collections.posts.length }})
      </a>
      {% for tag in collections.tagList %}
        <a href="/tags/{{ tag | slugify }}/" class="px-2.5 py-1 rounded-full text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors shrink-0">
          {{ tag }}
        </a>
      {% endfor %}
    </div>

    <!-- Quick Search Trigger -->
    <button type="button" 
            class="inline-flex items-center gap-2 text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors focus:outline-none shrink-0" 
            data-hs-overlay="#search-modal">
      {{ icons.icon("search", "w-3.5 h-3.5") }}
      <span>Search</span>
      <kbd class="px-1 py-0.5 text-[10px] font-mono bg-neutral-100 dark:bg-neutral-800 rounded text-neutral-400">⌘K</kbd>
    </button>
  </div>

  <!-- Posts List -->
  <div class="divide-y divide-neutral-200/60 dark:divide-neutral-800/60">
    {% for post in collections.posts %}
      {% include "components/post-card.njk" %}
    {% else %}
      <div class="py-12 text-center text-sm font-mono text-neutral-400">
        No posts published yet.
      </div>
    {% endfor %}
  </div>

  <!-- Subtle RSS Link -->
  <div class="pt-8 text-xs text-neutral-400 dark:text-neutral-500 font-mono">
    <span>Subscribe via </span>
    <a href="/feed.xml" class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-200">RSS / Atom Feed</a>
  </div>

</div>
