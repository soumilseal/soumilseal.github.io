---
layout: layouts/base.njk
title: Writing & Notes — Soumil Seal
description: Technical articles, system design explorations, and engineering notes on modern software development and cloud systems.
permalink: /blog/
---
{% import "components/icons.njk" as icons %}

{% include "components/profile-header.njk" %}

<div class="space-y-10 sm:space-y-12">

  <!-- Topic Filter Pills -->
  <div class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none text-xs font-mono">
    <a href="/blog/" class="px-3 py-1 rounded-full bg-neutral-900 text-white dark:bg-white dark:text-black transition-colors shrink-0 font-medium">
      All ({{ collections.posts.length }})
    </a>
    {% for tag in collections.tagList %}
      <a href="/tags/{{ tag | slugify }}/" class="px-3 py-1 rounded-full text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors shrink-0">
        {{ tag }}
      </a>
    {% endfor %}
  </div>

  <!-- Articles List with Left Section Label -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Articles
      </h2>
    </div>

    <div class="flex-grow space-y-8 w-full">
      {% for post in collections.posts %}
        <article class="space-y-2 pb-6 border-b border-neutral-100 dark:border-neutral-800/80 last:border-0 group">
          <div class="flex flex-wrap items-center gap-3 text-[11px] font-mono text-neutral-400 dark:text-neutral-500">
            <span class="inline-flex items-center gap-1">
              {{ icons.icon("calendar", "w-3 h-3 text-neutral-400") }}
              <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
            </span>
            <span>&bull;</span>
            <span class="inline-flex items-center gap-1">
              {{ icons.icon("clock", "w-3 h-3 text-neutral-400") }}
              <span>{{ post.templateContent | readingTime }}</span>
            </span>
            {% if post.data.featured %}
              <span class="ml-auto text-[10px] uppercase font-semibold text-accent-600 dark:text-accent-400">
                Featured
              </span>
            {% endif %}
          </div>

          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
            <a href="{{ post.url }}">
              {{ post.data.title }}
            </a>
          </h3>

          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {{ post.data.description }}
          </p>

          <div class="flex items-center justify-between pt-1">
            <div class="flex flex-wrap gap-1.5">
              {% for tag in post.data.tags | filterTagList %}
                <a href="/tags/{{ tag | slugify }}/" class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 hover:bg-neutral-200 text-neutral-600 dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:text-neutral-300 transition-colors">
                  {{ tag }}
                </a>
              {% endfor %}
            </div>

            <a href="{{ post.url }}" class="inline-flex items-center gap-1 text-xs font-mono text-accent-600 hover:text-accent-700 dark:text-accent-400 group-hover:translate-x-0.5 transition-transform">
              <span>Read</span>
              {{ icons.icon("arrow-right", "w-2.5 h-2.5") }}
            </a>
          </div>
        </article>
      {% else %}
        <div class="py-12 text-center text-xs text-neutral-400 font-mono">
          No articles published yet.
        </div>
      {% endfor %}
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- RSS Section -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8 pb-10">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Syndication
      </h2>
    </div>

    <div class="flex-grow space-y-2 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
      <p>
        Articles are syndicated via standard Atom/RSS. Add the link below to your feed reader:
      </p>
      <a href="/feed.xml" class="inline-flex items-center gap-1.5 font-mono text-neutral-800 dark:text-neutral-200 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
        {{ icons.icon("rss", "w-3.5 h-3.5 text-amber-500") }}
        <span>https://soumilseal.dev/feed.xml</span>
      </a>
    </div>
  </section>

</div>
