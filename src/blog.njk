---
layout: layouts/page.njk
title: Writing
description: Technical articles, system design explorations, and engineering notes on modern software development and cloud systems.
pagination:
  data: collections.posts
  size: 2
  alias: posts
permalink: "blog/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"

---
{% import "components/icons.njk" as icons %}

<div class="grow flex flex-col justify-between">
  <div class="grow flex flex-col">
    <!-- Search Bar: Contiguous Grid Cell -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between gap-3 shrink-0">
      <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400">
        articles // ({{ collections.posts.length }})
      </span>

      <!-- Quick Search Trigger -->
      <button
        type="button"
        class="inline-flex items-center gap-2 px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 text-xs font-mono text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white bg-white dark:bg-neutral-950 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors focus:outline-none cursor-pointer shrink-0"
        data-hs-overlay="#search-modal"
      >
        {{ icons.icon("search", "w-3.5 h-3.5") }}
        <span>Search articles</span>
        <span class="inline-flex items-center gap-1 font-mono text-[10px] text-neutral-500 dark:text-neutral-400 border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-900 px-1.5 py-0.5 tracking-tight">
          <kbd class="font-mono">Ctrl</kbd>
          <span class="text-neutral-400 dark:text-neutral-600">+</span>
          <kbd class="font-mono">K</kbd>
        </span>
      </button>
    </div>

    <!-- Posts List: Contiguous Divide-Y with Zero Spaces -->
    <div class="divide-y divide-neutral-300 dark:divide-neutral-800 border-b border-neutral-300 dark:border-neutral-800 shrink-0">
      {% for post in posts %}
        {% include "components/post-card.njk" %}
      {% else %}
        <div class="p-12 text-center text-sm font-mono text-neutral-400">
          No posts published yet.
        </div>
      {% endfor %}
    </div>

    <!-- Background Filler: Connects seamlessly to footer -->
    <div class="grow bg-white dark:bg-neutral-950"></div>
  </div>

  <div class="shrink-0">
    <!-- Pagination Navigation -->
    {% include "components/pagination.njk" %}

    <!-- Subtle RSS Link Bar -->
    <div class="px-4 sm:px-6 py-2 text-xs text-neutral-500 dark:text-neutral-400 font-mono bg-neutral-50/50 dark:bg-neutral-900/30 flex items-center justify-between border-t border-neutral-300 dark:border-neutral-800">
      <span>Subscribe to articles and technical notes</span>
      <a
        href="/feed.xml"
        class="inline-flex items-center gap-1.5 underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100"
      >
        <span>RSS / Atom Feed</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>
  </div>
</div>
