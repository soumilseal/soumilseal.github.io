---
layout: layouts/base.njk
title: Contact — Soumil Seal
description: Whether you have an internship opportunity, a technical question, or an open-source collaboration idea, I'd love to hear from you.
permalink: /contact/
---
{% import "components/icons.njk" as icons %}

{% include "components/profile-header.njk" %}

<div class="space-y-10 sm:space-y-12">

  <!-- Direct Email Section -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Email
      </h2>
    </div>

    <div class="flex-grow space-y-3 w-full">
      <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
        The fastest way to reach me directly for software opportunities, technical inquiries, or collaborations:
      </p>

      <div class="flex items-center justify-between p-3 rounded-lg border border-neutral-200/80 bg-neutral-50/70 dark:border-neutral-800 dark:bg-neutral-900/60 max-w-md">
        <span class="font-mono text-xs text-neutral-800 dark:text-neutral-200 truncate select-all" id="contact-email">
          {{ site.email }}
        </span>
        <button type="button" 
                id="copy-email-btn"
                class="px-2.5 py-1 text-xs font-mono rounded bg-neutral-900 text-white hover:bg-neutral-800 dark:bg-white dark:text-black dark:hover:bg-neutral-200 transition-colors shrink-0 flex items-center gap-1"
                aria-label="Copy email address to clipboard">
          {{ icons.icon("check", "w-3 h-3 hidden", id="copy-check-icon") }}
          <span id="copy-text">Copy</span>
        </button>
      </div>
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- Online Profiles Section -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Profiles
      </h2>
    </div>

    <div class="flex-grow space-y-3 text-xs font-mono">
      <div class="flex flex-wrap gap-4">
        <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          {{ icons.icon("github", "w-3.5 h-3.5 text-neutral-400") }}
          <span>GitHub</span>
        </a>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          {{ icons.icon("linkedin", "w-3.5 h-3.5 text-neutral-400") }}
          <span>LinkedIn</span>
        </a>
        <a href="{{ site.twitter }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          {{ icons.icon("twitter", "w-3.5 h-3.5 text-neutral-400") }}
          <span>Twitter/X</span>
        </a>
      </div>
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- Message Form Section -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8 pb-10">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Message
      </h2>
    </div>

    <div class="flex-grow w-full max-w-lg space-y-4">
      <form id="contact-form" class="space-y-4">
        <div>
          <label for="name" class="block text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-1">
            Name
          </label>
          <input type="text" id="name" name="name" required placeholder="Your name" 
                 class="w-full px-3 py-2 rounded-lg border border-neutral-200 bg-white text-neutral-900 text-xs font-sans focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:bg-neutral-900 dark:border-neutral-800 dark:text-white dark:focus:ring-white transition-colors">
        </div>

        <div>
          <label for="email" class="block text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-1">
            Email
          </label>
          <input type="email" id="email" name="email" required placeholder="your.email@example.com" 
                 class="w-full px-3 py-2 rounded-lg border border-neutral-200 bg-white text-neutral-900 text-xs font-sans focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:bg-neutral-900 dark:border-neutral-800 dark:text-white dark:focus:ring-white transition-colors">
        </div>

        <div>
          <label for="message" class="block text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-1">
            Message
          </label>
          <textarea id="message" name="message" rows="4" required placeholder="How can I help or what would you like to discuss?" 
                    class="w-full px-3 py-2 rounded-lg border border-neutral-200 bg-white text-neutral-900 text-xs font-sans focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:bg-neutral-900 dark:border-neutral-800 dark:text-white dark:focus:ring-white transition-colors resize-y"></textarea>
        </div>

        <div id="form-feedback" class="hidden p-2.5 rounded text-xs font-mono"></div>

        <button type="submit" 
                class="py-2 px-4 rounded bg-neutral-900 hover:bg-neutral-800 text-white dark:bg-white dark:text-black dark:hover:bg-neutral-200 text-xs font-mono transition-colors">
          Send Message
        </button>
      </form>
    </div>
  </section>

</div>

<!-- Copy Email & Form Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-text');
    const emailEl = document.getElementById('contact-email');

    if (copyBtn && emailEl) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(emailEl.innerText.trim());
          copyText.innerText = 'Copied';
          setTimeout(() => {
            copyText.innerText = 'Copy';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy email:', err);
        }
      });
    }

    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('form-feedback');

    if (form && feedback) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const message = document.getElementById('message').value;

        feedback.className = 'p-2.5 rounded text-xs font-mono bg-neutral-100 text-neutral-800 border border-neutral-200 dark:bg-neutral-800 dark:text-neutral-200 dark:border-neutral-700';
        feedback.innerHTML = `Preparing email to <strong>${emailEl.innerText.trim()}</strong>...`;
        feedback.classList.remove('hidden');

        const mailtoUri = `mailto:soumilseal@gmail.com?subject=Portfolio%20Inquiry%20from%20${encodeURIComponent(name)}&body=${encodeURIComponent("From: " + name + " <" + email + ">\n\n" + message)}`;
        setTimeout(() => {
          window.location.href = mailtoUri;
        }, 500);
      });
    }
  });
</script>
