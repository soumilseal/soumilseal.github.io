---
layout: layouts/page.njk
title: Contact
description: Have an internship opportunity, a project idea, or a question? Feel free to reach out.
permalink: /contact/

---
{% import "components/icons.njk" as icons %}

<div>
  <!-- Direct Channels Section (Contiguous Grid Cell) -->
  <section class="border-b border-neutral-300 dark:border-neutral-800">
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-6 sm:px-8 py-3 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          direct-channels/
        </h2>
      </div>
      <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >primary communication</span>
    </div>

    <div class="p-6 sm:p-8 space-y-4 bg-white dark:bg-[#0a0a0a]">
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
        The easiest way to reach me is directly by email:
      </p>
      <div class="flex items-center gap-3">
        <a
          href="mailto:{{ site.email }}"
          class="text-base sm:text-lg font-mono font-medium text-neutral-900 dark:text-neutral-100 underline underline-offset-4"
          id="contact-email"
        >
          {{ site.email }}
        </a>
        <button
          type="button"
          id="copy-email-btn"
          class="px-2.5 py-1 text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-white border border-neutral-300 dark:border-neutral-700 hover:border-neutral-500 dark:hover:border-neutral-500 transition-colors"
          aria-label="Copy email address"
        >
          <span id="copy-text">Copy</span>
        </button>
      </div>
    </div>

    <!-- Contiguous Channels Grid -->
    <div class="grid grid-cols-3 divide-x divide-neutral-300 dark:divide-neutral-800 border-t border-neutral-300 dark:border-neutral-800 text-xs font-mono bg-white dark:bg-[#0a0a0a]">
      <a
        href="{{ site.github }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>GitHub</span>
        <span>&nearr;</span>
      </a>
      <a
        href="{{ site.linkedin }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>LinkedIn</span>
        <span>&nearr;</span>
      </a>
      <a
        href="{{ site.twitter }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Twitter/X</span>
        <span>&nearr;</span>
      </a>
    </div>
  </section>

  <!-- Message Dispatch Form Section (Contiguous Grid Cell) -->
  <section>
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-6 sm:px-8 py-3 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          dispatch-message/
        </h2>
      </div>
      <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >interactive form</span>
    </div>

    <div class="p-6 sm:p-8 bg-white dark:bg-[#0a0a0a]">
      <form id="contact-form" class="space-y-5 max-w-xl">
        <div class="space-y-1.5">
          <label
            for="name"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            name/
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="Jane Doe"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors"
          >
        </div>

        <div class="space-y-1.5">
          <label
            for="email"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            email/
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="jane@example.com"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors"
          >
        </div>

        <div class="space-y-1.5">
          <label
            for="message"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            message/
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Your message..."
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors resize-y"
          ></textarea>
        </div>

        <div id="form-feedback" class="hidden p-3 text-xs font-mono"></div>

        <button
          type="submit"
          class="px-5 py-2.5 bg-primary-500 hover:bg-primary-600 text-neutral-950 font-mono text-xs font-bold tracking-tight transition-colors focus:outline-none flex items-center gap-1.5"
        >
          <span>Send message</span>
          <span>&rarr;</span>
        </button>
      </form>
    </div>
  </section>
</div>

<!-- Copy Email & Form Feedback Script -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  const copyBtn = document.getElementById("copy-email-btn");
  const copyText = document.getElementById("copy-text");
  const emailEl = document.getElementById("contact-email");

  if (copyBtn && emailEl) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(emailEl.innerText.trim());
        copyText.innerText = "Copied";
        setTimeout(() => {
          copyText.innerText = "Copy";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy email:", err);
      }
    });
  }

  const form = document.getElementById("contact-form");
  const feedback = document.getElementById("form-feedback");

  if (form && feedback) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = document.getElementById("name").value;
      const email = document.getElementById("email").value;
      const message = document.getElementById("message").value;

      feedback.className =
        "p-3 text-xs font-mono bg-neutral-100 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200 border border-neutral-300 dark:border-neutral-700";
      feedback.innerHTML =
        `Opening your email client to dispatch to <strong>${emailEl.innerText.trim()}</strong>...`;
      feedback.classList.remove("hidden");

      const mailtoUri = `mailto:${emailEl.innerText.trim()}?subject=${
        encodeURIComponent("Portfolio Contact from " + name)
      }&body=${
        encodeURIComponent("From: " + name + " <" + email + ">\n\n" + message)
      }`;
      setTimeout(() => {
        window.location.href = mailtoUri;
      }, 600);
    });
  }
});
</script>
