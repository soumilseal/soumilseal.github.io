---
layout: layouts/page.njk
title: Get in Touch
description: Whether you have an internship opportunity, a technical question, or an open-source collaboration idea, I'd love to hear from you.
permalink: /contact/
---
{% import "components/icons.njk" as icons %}

<div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
  
  <!-- Left Column: Direct Channels & Profiles -->
  <div class="md:col-span-5 space-y-6">
    <div class="p-6 rounded-2xl bg-white border border-neutral-200/80 dark:bg-neutral-900/60 dark:border-neutral-800 space-y-4">
      <h2 class="text-base font-bold text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
        {{ icons.icon("mail", "w-4 h-4 text-accent-500") }}
        <span>Direct Email</span>
      </h2>
      <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
        The fastest way to reach me for opportunities, project collaborations, or general questions:
      </p>

      <!-- Email Display & Copy Box -->
      <div class="p-3 rounded-xl bg-neutral-100/70 border border-neutral-200 dark:bg-neutral-800/80 dark:border-neutral-700/80 flex items-center justify-between gap-2">
        <span class="font-mono text-xs text-neutral-800 dark:text-neutral-200 select-all truncate" id="contact-email">
          {{ site.email }}
        </span>
        <button type="button" 
                id="copy-email-btn"
                class="px-2.5 py-1 text-xs font-mono rounded-lg bg-neutral-900 text-white hover:bg-neutral-800 dark:bg-accent-600 dark:hover:bg-accent-500 transition-colors shrink-0 flex items-center gap-1"
                aria-label="Copy email address to clipboard">
          {{ icons.icon("check", "w-3 h-3 hidden", id="copy-check-icon") }}
          <span id="copy-text">Copy</span>
        </button>
      </div>
    </div>

    <!-- Social Profiles Box -->
    <div class="p-6 rounded-2xl bg-white border border-neutral-200/80 dark:bg-neutral-900/60 dark:border-neutral-800 space-y-4">
      <h2 class="text-base font-bold text-neutral-900 dark:text-neutral-100 font-mono">
        Connect Online
      </h2>
      <ul class="space-y-3 text-xs">
        <li>
          <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2.5 rounded-xl border border-neutral-200/70 hover:border-neutral-300 dark:border-neutral-800 dark:hover:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white transition-all">
            <span class="flex items-center gap-2.5">
              {{ icons.icon("github", "w-4 h-4") }}
              <span class="font-medium">GitHub</span>
            </span>
            <span class="text-neutral-400 font-mono text-[11px]">@soumilseal</span>
          </a>
        </li>
        <li>
          <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2.5 rounded-xl border border-neutral-200/70 hover:border-neutral-300 dark:border-neutral-800 dark:hover:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white transition-all">
            <span class="flex items-center gap-2.5">
              {{ icons.icon("linkedin", "w-4 h-4") }}
              <span class="font-medium">LinkedIn</span>
            </span>
            <span class="text-neutral-400 font-mono text-[11px]">in/soumilseal</span>
          </a>
        </li>
        <li>
          <a href="{{ site.twitter }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-2.5 rounded-xl border border-neutral-200/70 hover:border-neutral-300 dark:border-neutral-800 dark:hover:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/40 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white transition-all">
            <span class="flex items-center gap-2.5">
              {{ icons.icon("twitter", "w-4 h-4") }}
              <span class="font-medium">Twitter / X</span>
            </span>
            <span class="text-neutral-400 font-mono text-[11px]">@soumilseal</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Right Column: Interactive Contact Form -->
  <div class="md:col-span-7">
    <div class="p-6 sm:p-8 rounded-2xl bg-white border border-neutral-200/80 dark:bg-neutral-900/60 dark:border-neutral-800 space-y-6">
      <div>
        <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">
          Send a Message
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 font-mono mt-1">
          I will reply within 24 to 48 hours.
        </p>
      </div>

      <form id="contact-form" class="space-y-4">
        <div>
          <label for="name" class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            Your Name <span class="text-accent-500">*</span>
          </label>
          <input type="text" id="name" name="name" required placeholder="Jane Doe" 
                 class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:bg-white dark:bg-neutral-800 dark:border-neutral-700 dark:text-white dark:focus:bg-neutral-800/90 transition-colors">
        </div>

        <div>
          <label for="email" class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            Your Email <span class="text-accent-500">*</span>
          </label>
          <input type="email" id="email" name="email" required placeholder="jane@example.com" 
                 class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:bg-white dark:bg-neutral-800 dark:border-neutral-700 dark:text-white dark:focus:bg-neutral-800/90 transition-colors">
        </div>

        <div>
          <label for="subject" class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            Subject
          </label>
          <input type="text" id="subject" name="subject" placeholder="Internship Inquiry / Project Collaboration" 
                 class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:bg-white dark:bg-neutral-800 dark:border-neutral-700 dark:text-white dark:focus:bg-neutral-800/90 transition-colors">
        </div>

        <div>
          <label for="message" class="block text-xs font-mono font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            Message <span class="text-accent-500">*</span>
          </label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell me about your project, idea, or questions..." 
                    class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-neutral-50 text-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:bg-white dark:bg-neutral-800 dark:border-neutral-700 dark:text-white dark:focus:bg-neutral-800/90 transition-colors resize-y"></textarea>
        </div>

        <div id="form-feedback" class="hidden p-3 rounded-xl text-xs font-mono"></div>

        <button type="submit" 
                class="w-full py-3 px-5 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-white dark:bg-accent-600 dark:hover:bg-accent-500 text-sm font-semibold transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-accent-500 flex items-center justify-center gap-2">
          <span>Send Message</span>
          {{ icons.icon("arrow-right", "w-4 h-4") }}
        </button>
      </form>
    </div>
  </div>

</div>

<!-- Copy Email & Form Feedback Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Copy email action
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-text');
    const emailEl = document.getElementById('contact-email');

    if (copyBtn && emailEl) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(emailEl.innerText.trim());
          copyText.innerText = 'Copied!';
          copyBtn.classList.remove('bg-neutral-900', 'dark:bg-accent-600');
          copyBtn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            copyText.innerText = 'Copy';
            copyBtn.classList.remove('bg-emerald-600', 'text-white');
            copyBtn.classList.add('bg-neutral-900', 'dark:bg-accent-600');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy email:', err);
        }
      });
    }

    // Contact form handling
    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('form-feedback');

    if (form && feedback) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const subject = document.getElementById('subject').value || 'Portfolio Contact';
        const message = document.getElementById('message').value;

        // Create mailto fallback link and notify user
        feedback.className = 'p-3 rounded-xl text-xs font-mono bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800';
        feedback.innerHTML = `Opening your email client to dispatch to <strong>${emailEl.innerText.trim()}</strong>. Thank you, ${name}!`;
        feedback.classList.remove('hidden');

        // Mailto trigger
        const mailtoUri = `mailto:soumilseal@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent("From: " + name + " <" + email + ">\n\n" + message)}`;
        setTimeout(() => {
          window.location.href = mailtoUri;
        }, 800);
      });
    }
  });
</script>
