---
layout: layouts/page.njk
title: Contact
description: Have an internship opportunity, a project idea, or a question? Feel free to reach out.
permalink: /contact/
---
{% import "components/icons.njk" as icons %}

<div class="space-y-10">
  
  <!-- Direct Channels (Vercel Card with Sharp Corners) -->
  <div class="vercel-card group relative p-6 border border-neutral-200 dark:border-neutral-800/80 bg-white dark:bg-[#120404] space-y-4 text-sm text-neutral-600 dark:text-neutral-400">
    {{ icons.vercel_corners() }}

    <p class="leading-relaxed">
      The easiest way to reach me is directly by email:
    </p>
    <div class="flex items-center gap-3">
      <a href="mailto:{{ site.email }}" class="text-base font-medium text-neutral-900 dark:text-neutral-100 underline underline-offset-4" id="contact-email">
        {{ site.email }}
      </a>
      <button type="button" 
              id="copy-email-btn"
              class="px-2.5 py-1 text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-white border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
              aria-label="Copy email address">
        <span id="copy-text">Copy</span>
      </button>
    </div>

    <div class="flex items-center gap-4 text-xs font-mono pt-2 border-t border-neutral-100 dark:border-neutral-800/60">
      <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        GitHub &nearr;
      </a>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        LinkedIn &nearr;
      </a>
      <a href="{{ site.twitter }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        Twitter/X &nearr;
      </a>
    </div>
  </div>

  <!-- Minimal Form (Vercel Card with Sharp Corners) -->
  <div class="vercel-card group relative p-6 sm:p-8 border border-neutral-200 dark:border-neutral-800/80 bg-white dark:bg-[#120404] space-y-6">
    {{ icons.vercel_corners() }}

    <div class="space-y-1">
      <h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
        Send a message
      </h2>
      <p class="text-xs font-mono text-neutral-400">
        Fill out the details below to dispatch an email.
      </p>
    </div>

    <form id="contact-form" class="space-y-5">
      <div class="space-y-1.5">
        <label for="name" class="block text-xs font-mono text-neutral-500 dark:text-neutral-400">
          Name
        </label>
        <input type="text" id="name" name="name" required placeholder="Jane Doe" 
               class="w-full px-3.5 py-2.5 border border-neutral-200 dark:border-neutral-800 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-neutral-500 dark:focus:border-neutral-400 transition-colors">
      </div>

      <div class="space-y-1.5">
        <label for="email" class="block text-xs font-mono text-neutral-500 dark:text-neutral-400">
          Email
        </label>
        <input type="email" id="email" name="email" required placeholder="jane@example.com" 
               class="w-full px-3.5 py-2.5 border border-neutral-200 dark:border-neutral-800 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-neutral-500 dark:focus:border-neutral-400 transition-colors">
      </div>

      <div class="space-y-1.5">
        <label for="message" class="block text-xs font-mono text-neutral-500 dark:text-neutral-400">
          Message
        </label>
        <textarea id="message" name="message" rows="4" required placeholder="Your message..." 
                  class="w-full px-3.5 py-2.5 border border-neutral-200 dark:border-neutral-800 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-neutral-500 dark:focus:border-neutral-400 transition-colors resize-y"></textarea>
      </div>

      <div id="form-feedback" class="hidden p-3 text-xs font-mono"></div>

      <button type="submit" 
              class="px-5 py-2.5 border border-neutral-900 bg-neutral-900 hover:bg-neutral-800 text-white dark:border-neutral-100 dark:bg-neutral-100 dark:hover:bg-white dark:text-neutral-900 text-sm font-medium transition-colors focus:outline-none">
        Send message &rarr;
      </button>
    </form>
  </div>

</div>

<!-- Copy Email & Form Feedback Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-text');
    const emailEl = document.getElementById('contact-email');

    if (copyBtn && emailEl) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(emailEl.innerText.trim());
          copyText.innerText = 'Copied';
          setTimeout(() => {
            copyText.innerText = 'Copy';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy email:', err);
        }
      });
    }

    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('form-feedback');

    if (form && feedback) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const message = document.getElementById('message').value;

        feedback.className = 'p-3 text-xs font-mono bg-neutral-100 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700';
        feedback.innerHTML = `Opening your email client to dispatch to <strong>${emailEl.innerText.trim()}</strong>...`;
        feedback.classList.remove('hidden');

        const mailtoUri = `mailto:${emailEl.innerText.trim()}?subject=${encodeURIComponent("Portfolio Contact from " + name)}&body=${encodeURIComponent("From: " + name + " <" + email + ">\n\n" + message)}`;
        setTimeout(() => {
          window.location.href = mailtoUri;
        }, 600);
      });
    }
  });
</script>
