---
layout: layouts/page.njk
title: Contact
description: Have an internship opportunity, a project idea, or a question? Feel free to reach out.
permalink: /contact/

---
{% import "components/icons.njk" as icons %}

<div class="grow flex flex-col justify-between">
  <!-- Direct Channels Section (Contiguous Grid Cell) -->
  <section class="border-b border-neutral-300 dark:border-neutral-800">
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ contact.channels.title or "direct-channels" }}
        </h2>
      </div>
      <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >{{ contact.channels.subtitle or "primary communication" }}</span>
    </div>

    <div class="p-6 sm:p-8 space-y-4 bg-white dark:bg-neutral-950">
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
        {{ contact.channels.prompt or "Connect directly via my verified professional profiles below, or dispatch a message through the form:" }}
      </p>
    </div>

    <!-- Contiguous Channels Grid -->
    <div class="grid grid-cols-3 divide-x divide-neutral-300 dark:divide-neutral-800 border-t border-neutral-300 dark:border-neutral-800 text-xs font-mono bg-white dark:bg-neutral-950">
      <a
        href="{{ site.github }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>GitHub</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.linkedin }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>LinkedIn</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.twitter }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Twitter/X</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>
  </section>

  <!-- Message Dispatch Form Section (Contiguous Grid Cell) -->
  <section>
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ contact.form.title or "dispatch-message" }}
        </h2>
      </div>
      <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >{{ contact.form.subtitle or "interactive form" }}</span>
    </div>

    <div class="p-6 sm:p-8 bg-white dark:bg-neutral-950">
      <form id="form" class="contact-dispatch-form space-y-5 w-full" action="{{ contact.form.action or 'https://api.web3forms.com/submit' }}" method="POST">
        <input type="hidden" name="access_key" value="{{ contact.form.accessKey or 'ba639b9a-3fc5-4dfa-9576-acf24ea3f2da' }}">
        <div class="space-y-1.5">
          <label
            for="name"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            {{ contact.form.nameLabel or "name" }}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="{{ contact.form.namePlaceholder or 'Jane Doe' }}"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors"
          >
        </div>

        <div class="space-y-1.5">
          <label
            for="email"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            {{ contact.form.emailLabel or "email" }}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="{{ contact.form.emailPlaceholder or 'jane@example.com' }}"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors"
          >
        </div>

        <div class="space-y-1.5">
          <label
            for="message"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            {{ contact.form.messageLabel or "message" }}
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="{{ contact.form.messagePlaceholder or 'Your message...' }}"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors resize-y"
          ></textarea>
        </div>

        <div class="form-feedback hidden p-3.5 text-xs font-mono"></div>

        <button
          type="submit"
          class="px-5 py-2.5 bg-primary-500 hover:bg-primary-600 text-neutral-950 font-mono text-xs font-bold tracking-tight transition-colors focus:outline-none flex items-center gap-2 group cursor-pointer"
        >
          <span>{{ contact.form.submitButtonText or "Submit" }}</span>
          <span class="group-hover:translate-x-1 transition-transform flex items-center">{{ icons.icon("arrow-right", "w-3.5 h-3.5") }}</span>
        </button>
      </form>
    </div>
  </section>
</div>
