---
layout: layouts/page.njk
title: About
description: Developer, BCA student, and systems enthusiast building software across web architecture, cloud pipelines, and distributed backends.
permalink: /about/

---
{% import "components/icons.njk" as icons %}

<div class="grow flex flex-col justify-between">
  <!-- Narrative Section: Contiguous Grid Split -->
  <section class="border-b border-neutral-300 dark:border-neutral-800">
    <div class="grid grid-cols-1 sm:grid-cols-12">
      <!-- Avatar Cell: Edge-to-Edge Full-Box Square Image -->
      <div class="sm:col-span-5 border-b sm:border-b-0 sm:border-r border-neutral-300 dark:border-neutral-800 bg-neutral-950 overflow-hidden">
        <div class="aspect-square w-full relative overflow-hidden group">
          <img
            src="{{ about.avatar or '/assets/images/me.jpg' }}"
            alt="{{ site.name or 'Soumil Seal' }}"
            class="w-full h-full object-cover object-center filter brightness-[0.98] contrast-[1.02] transition-transform duration-700 group-hover:scale-105"
            width="800"
            height="800"
            loading="eager"
          >
          <div class="absolute inset-0 bg-neutral-900/10 dark:bg-neutral-900/20 pointer-events-none"></div>
        </div>
      </div>

      <!-- Narrative Text Cell -->
      <div class="sm:col-span-7 p-6 sm:p-8 space-y-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans bg-white dark:bg-neutral-950 flex flex-col justify-center">
        {% if about.narrative and about.narrative.paragraphs %}
          {% for p in about.narrative.paragraphs %}
            {% if loop.index <= 2 %}
              <p>{{ p | safe }}</p>
            {% endif %}
          {% endfor %}
        {% else %}
          <p>
            I'm <strong class="text-neutral-900 dark:text-neutral-100 font-semibold">Soumil Seal</strong>, a software developer and Bachelor of Computer Applications (BCA) undergraduate student based in India.
          </p>
          <p>
            My interest in software engineering began with curiosity about how large distributed web services remain fast and dependable under heavy concurrency. That curiosity led me from basic algorithmic scripts in C and Python to designing full-stack systems, containerized cloud pipelines, and developer tooling.
          </p>
        {% endif %}
      </div>
    </div>

    <!-- Extended Story Text Cell -->
    {% set hasExtended = false %}
    {% if about.narrative and about.narrative.paragraphs and about.narrative.paragraphs.length > 2 %}
      {% set hasExtended = true %}
    {% endif %}

    {% if hasExtended or not about.narrative %}
      <div class="p-6 sm:p-8 border-t border-neutral-300 dark:border-neutral-800 space-y-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans bg-white dark:bg-neutral-950">
        {% if hasExtended %}
          {% for p in about.narrative.paragraphs %}
            {% if loop.index > 2 %}
              <p>{{ p | safe }}</p>
            {% endif %}
          {% endfor %}
        {% else %}
          <p>
            Today, my focus centers on <span class="text-neutral-900 dark:text-neutral-100 font-medium">software engineering, backend systems, and cloud infrastructure</span>. I enjoy dissecting runtime mechanics—whether that's understanding how the V8 engine manages microtask queues, how containers coordinate through Linux cgroups, or how relational database query planners optimize multi-table joins.
          </p>
          <p>
            Outside of university coursework and software development, I document my experiments on my blog, contribute to open-source software, and participate in technical communities.
          </p>
        {% endif %}
      </div>
    {% endif %}
  </section>

  <!-- Technical Skills Section: Contiguous Bento Grid -->
  <section class="border-b border-neutral-300 dark:border-neutral-800">
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ about.skillsSection.title or "skills-and-technologies" }}
        </h2>
      </div>
      <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >{{ about.skillsSection.subtitle or "core stack" }}</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-neutral-300 dark:divide-neutral-800 bg-neutral-300 dark:bg-neutral-800 gap-px">
      {% if about.skillsSection and about.skillsSection.categories %}
        {% for cat in about.skillsSection.categories %}
          <div class="bg-white dark:bg-neutral-950 p-6 space-y-2">
            <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-900 dark:text-neutral-100 font-semibold flex items-center gap-1.5">
              <span>{{ cat.name }}</span>
            </h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
              {{ cat.description }}
            </p>
          </div>
        {% endfor %}
      {% else %}
        <!-- Languages -->
        <div class="bg-white dark:bg-neutral-950 p-6 space-y-2">
          <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-900 dark:text-neutral-100 font-semibold flex items-center gap-1.5">
            <span>Languages</span>
          </h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
            Python, TypeScript, JavaScript (ESNext), Go, Java, C/C++, SQL, Bash.
          </p>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- Education Section: Contiguous Grid Cell -->
  <section class="border-b border-neutral-300 dark:border-neutral-800">
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ about.education.title or "academic-background" }}
        </h2>
      </div>
      <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >{{ about.education.subtitle or "university studies" }}</span>
    </div>

    <div class="p-6 sm:p-8 space-y-2 bg-white dark:bg-neutral-950">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h3 class="font-semibold text-neutral-900 dark:text-neutral-100 text-base">
          {{ about.education.degree or "Bachelor of Computer Applications (BCA)" }}
        </h3>
        <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500"
        >{{ about.education.status or "Present" }}</span>
      </div>
      <p class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
        {{ about.education.major or "Major in Computer Science & Applications" }}
      </p>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed pt-2 font-sans max-w-2xl">
        {{ about.education.coursework or "Core coursework covering Data Structures & Algorithms, Object-Oriented Software Design, Relational Database Management Systems (RDBMS), Operating Systems, and Computer Networks." }}
      </p>
    </div>
  </section>

  <!-- Connect Section: Contiguous Grid Cell -->
  <section>
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ about.connect.title or "network-and-channels" }}
        </h2>
      </div>
      <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >connect</span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-neutral-300 dark:divide-neutral-800 text-xs font-mono bg-white dark:bg-neutral-950">
      <a
        href="/contact/"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Contact</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.github }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>GitHub</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.linkedin }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>LinkedIn</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.twitter }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Twitter/X</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>
  </section>
</div>
