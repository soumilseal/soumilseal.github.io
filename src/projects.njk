---
layout: layouts/base.njk
title: Projects & Software — Soumil Seal
description: A curated catalog of software tools, background daemons, cloud pipelines, and web applications I've designed and built.
permalink: /projects/
---
{% import "components/icons.njk" as icons %}

{% include "components/profile-header.njk" %}

<div class="space-y-10 sm:space-y-12" data-pagefind-body>

  <!-- Interactive Search & Category Filter Bar -->
  <div class="space-y-3.5">
    <!-- Live Search Input -->
    <div class="relative w-full">
      <input type="text" 
             id="project-search-input" 
             placeholder="Search projects by title, stack, or keywords..." 
             autocomplete="off"
             class="w-full pl-9 pr-20 py-2 rounded-xl border border-neutral-200/90 dark:border-neutral-800 bg-neutral-50/80 dark:bg-neutral-900/60 text-xs font-mono text-neutral-900 dark:text-neutral-100 placeholder:text-neutral-400 focus:outline-none focus:ring-1 focus:ring-neutral-900 dark:focus:ring-white transition-all shadow-2xs">
      <div class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
        {{ icons.icon("search", "w-3.5 h-3.5") }}
      </div>
      <button type="button" 
              data-hs-overlay="#search-modal" 
              class="absolute right-2.5 top-1/2 -translate-y-1/2 px-2 py-0.5 rounded text-[10px] font-mono text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white bg-neutral-200/60 dark:bg-neutral-800 transition-colors cursor-pointer" 
              title="Open full Pagefind search">
        Ctrl+K
      </button>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs font-mono" id="project-category-filters">
      <button type="button" 
              class="project-filter-btn px-3 py-1 rounded-full bg-neutral-900 text-white dark:bg-white dark:text-black font-medium transition-all shrink-0 cursor-pointer" 
              data-category="all">
        All (<span id="project-count">{{ projects.length }}</span>)
      </button>
      <button type="button" 
              class="project-filter-btn px-3 py-1 rounded-full text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0 cursor-pointer" 
              data-category="Cloud & Infrastructure">
        Cloud &amp; Infra
      </button>
      <button type="button" 
              class="project-filter-btn px-3 py-1 rounded-full text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0 cursor-pointer" 
              data-category="Developer Tools">
        Developer Tools
      </button>
      <button type="button" 
              class="project-filter-btn px-3 py-1 rounded-full text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0 cursor-pointer" 
              data-category="Web & Fullstack">
        Web
      </button>
      <button type="button" 
              class="project-filter-btn px-3 py-1 rounded-full text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0 cursor-pointer" 
              data-category="Systems">
        Systems
      </button>
    </div>
  </div>

  <!-- Projects List in Architectural Grid Layout -->
  <section class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start py-8 border-t border-neutral-200/80 dark:border-neutral-800/80">
    <div class="sm:col-span-3 sm:border-r border-neutral-200/80 dark:border-neutral-800/80 sm:pr-4">
      <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        Catalog
      </h2>
      <p class="text-[11px] font-mono text-neutral-400 dark:text-neutral-600 mt-1 hidden sm:block">
        Software &amp; tooling
      </p>
    </div>

    <div class="sm:col-span-9 sm:pl-2 space-y-8 w-full" id="projects-grid">
      {% for project in projects %}
        <div class="project-card space-y-2.5 pb-8 border-b border-neutral-100 dark:border-neutral-800/80 last:border-0 group" 
             data-title="{{ project.title | lower }}"
             data-description="{{ project.description | lower }}"
             data-category="{{ project.category }}"
             data-tags="{{ project.tags | join(',') | lower }}">
          
          <div class="flex flex-wrap items-baseline gap-2">
            <h3 class="text-sm sm:text-base font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
              <a href="{{ project.demo or project.github }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5">
                <span>{{ project.title }}</span>
                {{ icons.icon("external-link", "w-3 h-3 text-neutral-400 group-hover:text-accent-500 transition-colors") }}
              </a>
            </h3>
            <span class="text-xs font-normal text-neutral-400 dark:text-neutral-500 font-mono">
              {{ project.category }}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {{ project.description }}
          </p>

          <!-- Technical Highlights Connected Grid Cells -->
          {% if project.highlights %}
            <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200/80 dark:divide-neutral-800/80 border border-neutral-200/80 dark:border-neutral-800/80 rounded-lg overflow-hidden bg-neutral-50/50 dark:bg-neutral-900/40 text-[11px] text-neutral-600 dark:text-neutral-400 leading-snug">
              {% for highlight in project.highlights %}
                <div class="p-2.5 flex items-center">
                  {{ highlight }}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <div class="flex flex-wrap items-center justify-between gap-3 pt-1 text-[11px] font-mono text-neutral-400 dark:text-neutral-500">
            <div class="flex flex-wrap gap-1.5">
              {% for tag in project.tags %}
                <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300">
                  {{ tag }}
                </span>
              {% endfor %}
            </div>

            <div class="flex items-center gap-3">
              {% if project.github %}
                <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
                  {{ icons.icon("github", "w-3 h-3") }}
                  <span>Source</span>
                </a>
              {% endif %}
              {% if project.demo %}
                <a href="{{ project.demo }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-accent-600 dark:text-accent-400 hover:underline">
                  <span>Demo</span>
                  {{ icons.icon("arrow-right", "w-2.5 h-2.5") }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}

      <!-- No Results State -->
      <div id="no-projects-found" class="hidden py-12 text-center text-xs text-neutral-400 dark:text-neutral-500 font-mono space-y-3">
        <p>No projects match your search criteria.</p>
        <button type="button" data-hs-overlay="#search-modal" class="inline-flex items-center gap-1 text-accent-600 dark:text-accent-400 hover:underline cursor-pointer">
          {{ icons.icon("search", "w-3 h-3") }}
          <span>Search entire site with Pagefind</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Engineering Approach Section in Architectural Grid Layout -->
  <section class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start py-8 border-t border-neutral-200/80 dark:border-neutral-800/80">
    <div class="sm:col-span-3 sm:border-r border-neutral-200/80 dark:border-neutral-800/80 sm:pr-4">
      <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        Approach
      </h2>
      <p class="text-[11px] font-mono text-neutral-400 dark:text-neutral-600 mt-1 hidden sm:block">
        Design principles
      </p>
    </div>

    <div class="sm:col-span-9 sm:pl-2 space-y-4 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
      <div class="grid grid-cols-1 sm:grid-cols-3 border border-neutral-200/80 dark:border-neutral-800/80 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200/80 dark:divide-neutral-800/80 rounded-lg overflow-hidden bg-neutral-50/40 dark:bg-neutral-900/40">
        <div class="p-3.5 space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-200 font-mono text-xs">Minimal Footprint</h3>
          <p class="text-[11px] leading-relaxed">Prioritizing standard libraries, native runtime primitives, and minimal dependency overhead.</p>
        </div>
        <div class="p-3.5 space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-200 font-mono text-xs">Observability</h3>
          <p class="text-[11px] leading-relaxed">Embedding structured metrics, Prometheus exporters, and health checks by default.</p>
        </div>
        <div class="p-3.5 space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-200 font-mono text-xs">Fault Tolerance</h3>
          <p class="text-[11px] leading-relaxed">Designing idempotent message handlers, graceful termination, and safe recovery queues.</p>
        </div>
      </div>
    </div>
  </section>

</div>

<!-- Filter and Search Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('project-search-input');
    const filterBtns = document.querySelectorAll('.project-filter-btn');
    const projectCards = document.querySelectorAll('.project-card');
    const noResults = document.getElementById('no-projects-found');
    const projectCount = document.getElementById('project-count');

    let currentCategory = 'all';
    let searchQuery = '';

    function filterProjects() {
      let visibleCount = 0;

      projectCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-description') || '';
        const category = card.getAttribute('data-category') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesQuery = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery) || tags.includes(searchQuery) || category.toLowerCase().includes(searchQuery);
        const matchesCategory = currentCategory === 'all' || category === currentCategory;

        if (matchesQuery && matchesCategory) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (projectCount && currentCategory === 'all' && !searchQuery) {
        projectCount.textContent = projectCards.length;
      }

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        filterProjects();
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          if (typeof window.openSearchModalWithQuery === 'function') {
            window.openSearchModalWithQuery(searchInput.value.trim());
          }
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category');

        filterBtns.forEach(b => {
          b.classList.remove('bg-neutral-900', 'text-white', 'dark:bg-white', 'dark:text-black', 'font-medium');
          b.classList.add('text-neutral-500', 'dark:text-neutral-400');
        });

        btn.classList.add('bg-neutral-900', 'text-white', 'dark:bg-white', 'dark:text-black', 'font-medium');
        btn.classList.remove('text-neutral-500', 'dark:text-neutral-400');

        filterProjects();
      });
    });
  });
</script>
