---
layout: layouts/base.njk
title: Projects & Software — Soumil Seal
description: A curated catalog of software tools, background daemons, cloud pipelines, and web applications I've designed and built.
permalink: /projects/
---
{% import "components/icons.njk" as icons %}

{% include "components/profile-header.njk" %}

<div class="space-y-10 sm:space-y-12">

  <!-- Interactive Category Filtering -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="project-filters">
    <button type="button" class="project-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium bg-neutral-900 text-white dark:bg-white dark:text-black transition-all" data-category="all">
      All ({{ projects.length }})
    </button>
    <button type="button" class="project-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0" data-category="Cloud & Infrastructure">
      Cloud
    </button>
    <button type="button" class="project-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0" data-category="Developer Tools">
      Developer Tools
    </button>
    <button type="button" class="project-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0" data-category="Web & Fullstack">
      Web
    </button>
    <button type="button" class="project-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-all shrink-0" data-category="Systems">
      Systems
    </button>
  </div>

  <!-- Projects List with Left-Aligned Section Header -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Catalog
      </h2>
    </div>

    <div class="flex-grow space-y-8 w-full" id="projects-grid">
      {% for project in projects %}
        <div class="project-item space-y-2.5 pb-8 border-b border-neutral-100 dark:border-neutral-800/80 last:border-0 group" data-category="{{ project.category }}">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
              <a href="{{ project.demo or project.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors inline-flex items-center gap-1.5">
                <span>{{ project.title }}</span>
                {{ icons.icon("external-link", "w-3 h-3 text-neutral-400 group-hover:text-accent-500 transition-colors") }}
              </a>
            </h3>
            <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 shrink-0">
              {{ project.category }}
            </span>
          </div>

          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {{ project.description }}
          </p>

          <!-- Technical Highlights Cards -->
          {% if project.highlights %}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
              {% for highlight in project.highlights %}
                <div class="p-2.5 rounded-lg border border-neutral-200/70 bg-neutral-50/60 dark:border-neutral-800 dark:bg-neutral-900/50 text-[11px] text-neutral-600 dark:text-neutral-400 leading-snug">
                  {{ highlight }}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <div class="flex items-center justify-between gap-4 pt-1">
            <div class="flex flex-wrap gap-1.5">
              {% for tag in project.tags %}
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                  {{ tag }}
                </span>
              {% endfor %}
            </div>

            <div class="flex items-center gap-3 text-xs font-mono shrink-0">
              {% if project.github %}
                <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors inline-flex items-center gap-1">
                  {{ icons.icon("github", "w-3 h-3") }}
                  <span>Source</span>
                </a>
              {% endif %}
              {% if project.demo %}
                <a href="{{ project.demo }}" target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:text-accent-700 dark:text-accent-400 transition-colors inline-flex items-center gap-1">
                  <span>Demo</span>
                  {{ icons.icon("arrow-right", "w-2.5 h-2.5") }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- Engineering Approach Section -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8 pb-10">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Approach
      </h2>
    </div>

    <div class="flex-grow space-y-4 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-200 font-mono">Minimal Footprint</h3>
          <p>Prioritizing standard libraries, native runtime primitives, and minimal dependency overhead.</p>
        </div>
        <div class="space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-200 font-mono">Observability</h3>
          <p>Embedding structured metrics, Prometheus exporters, and health checks by default.</p>
        </div>
        <div class="space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-200 font-mono">Fault Tolerance</h3>
          <p>Designing idempotent message handlers, graceful termination, and safe recovery queues.</p>
        </div>
      </div>
    </div>
  </section>

</div>

<!-- Filter Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.project-filter-btn');
    const projectItems = document.querySelectorAll('.project-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        filterBtns.forEach(b => {
          b.classList.remove('bg-neutral-900', 'text-white', 'dark:bg-white', 'dark:text-black');
          b.classList.add('text-neutral-500', 'dark:text-neutral-400');
        });
        btn.classList.add('bg-neutral-900', 'text-white', 'dark:bg-white', 'dark:text-black');
        btn.classList.remove('text-neutral-500', 'dark:text-neutral-400');

        projectItems.forEach(item => {
          if (category === 'all' || item.getAttribute('data-category') === category) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
