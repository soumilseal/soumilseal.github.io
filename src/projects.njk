---
layout: layouts/page.njk
title: Projects
description: Software tools, distributed background workers, cloud pipelines, and web applications I've designed and built.
pagination:
  data: projects
  size: 3
  alias: pagedProjects
permalink: "projects/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"

---
{% import "components/icons.njk" as icons %}

<div class="grow flex flex-col justify-between">
  <div class="grow flex flex-col">
    <!-- Header / Meta Bar: Contiguous Grid Cell -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between gap-3 font-mono text-xs text-neutral-500 dark:text-neutral-400 shrink-0">
      <span>
        all-projects // index ({{ projects.length }})
      </span>
      <span>
        page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}
      </span>
    </div>

    <!-- Projects Grid: 3 Columns on Desktop, Zero Gaps -->
    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-300 dark:divide-neutral-800 border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950 shrink-0">
      {% for project in pagedProjects %}
        {% include "components/project-card.njk" %}
      {% else %}
        <div class="col-span-3 p-12 text-center text-sm font-mono text-neutral-400">
          No projects listed yet.
        </div>
      {% endfor %}
    </div>

    <!-- Background Filler: Connects seamlessly to footer -->
    <div class="grow bg-white dark:bg-neutral-950"></div>
  </div>

  <!-- Pagination Navigation -->
  <div class="shrink-0">
    {% include "components/pagination.njk" %}
  </div>
</div>
