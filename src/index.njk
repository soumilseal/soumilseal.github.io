---
layout: layouts/base.njk
title: Soumil Seal — Developer & BCA Student
description: Personal portfolio and technical blog of Soumil Seal. Focused on software development, cloud infrastructure, and modern web engineering.
---
{% import "components/icons.njk" as icons %}

{% include "components/profile-header.njk" %}

<div class="space-y-10 sm:space-y-12">

  <!-- Section: Projects -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Projects
      </h2>
    </div>

    <div class="flex-grow space-y-8 w-full">
      {% for project in projects | head(3) %}
        <div class="space-y-2 group">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
              <a href="{{ project.demo or project.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors inline-flex items-center gap-1.5">
                <span>{{ project.title }}</span>
                {{ icons.icon("external-link", "w-3 h-3 text-neutral-400 group-hover:text-accent-500 transition-colors") }}
              </a>
            </h3>
            <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500">
              {{ project.category }}
            </span>
          </div>

          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {{ project.description }}
          </p>

          <!-- Visual Mini Previews / Highlights -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
            {% for highlight in project.highlights %}
              <div class="p-2.5 rounded-lg border border-neutral-200/70 bg-neutral-50/60 dark:border-neutral-800 dark:bg-neutral-900/50 text-[11px] text-neutral-600 dark:text-neutral-400 leading-snug">
                {{ highlight }}
              </div>
            {% endfor %}
          </div>

          <div class="flex flex-wrap gap-1.5 pt-1">
            {% for tag in project.tags %}
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                {{ tag }}
              </span>
            {% endfor %}
          </div>
        </div>
      {% endfor %}

      <div class="pt-2">
        <a href="/projects/" class="inline-flex items-center gap-1 text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          <span>View all {{ projects.length }} projects</span>
          {{ icons.icon("arrow-right", "w-3 h-3") }}
        </a>
      </div>
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- Section: Now -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Now
      </h2>
    </div>

    <div class="flex-grow space-y-3 text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
      <p>
        I am currently completing my undergraduate degree in <strong class="text-neutral-900 dark:text-white font-medium">Computer Applications (BCA)</strong>, focusing on systems architecture, cloud infrastructure, and modern web application development.
      </p>
      <p class="text-neutral-600 dark:text-neutral-400">
        In my spare time, I build lightweight developer tools, experiment with containerization patterns on AWS, and write technical articles dissecting runtime mechanics and distributed queueing.
      </p>
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- Section: Previously / Education -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Education
      </h2>
    </div>

    <div class="flex-grow space-y-3 text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
      <p>
        Undergraduate studies in <strong class="text-neutral-900 dark:text-white font-medium">Computer Applications</strong> covering relational database design, operating system fundamentals, data structures, and computer networks. 
      </p>
      <p class="text-neutral-600 dark:text-neutral-400">
        Previously explored low-level programming in C and systems scripting in Python before focusing on modern TypeScript, Go, and cloud-native architecture.
      </p>
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- Section: Writing / Posts -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Writing
      </h2>
    </div>

    <div class="flex-grow space-y-4 w-full">
      <div class="space-y-4">
        {% for post in collections.posts | head(3) %}
          <div class="group flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 pb-3 border-b border-neutral-100 dark:border-neutral-800/60 last:border-0">
            <div class="space-y-1">
              <a href="{{ post.url }}" class="text-sm font-medium text-neutral-900 dark:text-neutral-100 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                {{ post.data.title }}
              </a>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-1">
                {{ post.data.description }}
              </p>
            </div>
            <div class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 shrink-0 sm:text-right">
              <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="pt-2">
        <a href="/blog/" class="inline-flex items-center gap-1 text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          <span>Read all articles</span>
          {{ icons.icon("arrow-right", "w-3 h-3") }}
        </a>
      </div>
    </div>
  </section>

  <hr class="border-t border-neutral-200/70 dark:border-neutral-800/70 my-8">

  <!-- Section: Connect -->
  <section class="flex flex-col sm:flex-row items-start gap-4 sm:gap-8 pb-10">
    <div class="sm:w-24 shrink-0">
      <h2 class="text-xs sm:text-sm font-normal text-neutral-400 dark:text-neutral-500 font-mono">
        Connect
      </h2>
    </div>

    <div class="flex-grow space-y-3 text-sm">
      <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-xs">
        I am always open to engineering discussions, internships, and open-source collaborations.
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs font-mono pt-1">
        <a href="mailto:{{ site.email }}" class="inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          {{ icons.icon("mail", "w-3.5 h-3.5 text-neutral-400") }}
          <span>{{ site.email }}</span>
        </a>
        <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          {{ icons.icon("github", "w-3.5 h-3.5 text-neutral-400") }}
          <span>GitHub</span>
        </a>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          {{ icons.icon("linkedin", "w-3.5 h-3.5 text-neutral-400") }}
          <span>LinkedIn</span>
        </a>
        <a href="{{ site.twitter }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
          {{ icons.icon("twitter", "w-3.5 h-3.5 text-neutral-400") }}
          <span>Twitter/X</span>
        </a>
      </div>
    </div>
  </section>

</div>
