---
layout: layouts/base.njk
title: Soumil Seal — Developer & BCA Student
description: Personal portfolio and technical blog of Soumil Seal. Focused on software development, cloud infrastructure, and modern web engineering.

---
{% import "components/icons.njk" as icons %}

<div class="max-w-[950px] w-full mx-auto border-x border-neutral-300 dark:border-neutral-800 relative bg-white dark:bg-neutral-950 grow flex flex-col">
  <!-- Hero Section: Compact Minimalist Bento Grid -->
  <section class="border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950">
    <!-- Micro Header Bar (Status & Metadata) -->
    <div class="px-4 sm:px-6 py-1.5 border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 flex items-center justify-between text-[11px] sm:text-xs font-mono text-neutral-500 dark:text-neutral-400">
      <div class="flex items-center gap-2 shrink-0">
        <span class="whitespace-nowrap">{{
          home.status.portfolioTag or "soumilseal // portfolio '26"
        }}</span>
      </div>
      {% if home.status.available != false %}
        <div class="flex items-center gap-1.5 text-blue-600 dark:text-blue-400 font-medium shrink-0">
          <span class="whitespace-nowrap">{{
            home.status.availabilityText or "open for opportunities"
          }}</span>
        </div>
      {% endif %}
    </div>

    <!-- 3-Cell Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12">
      <!-- CELL 1: Primary Profile & Bio Anchor Cell (7 Columns on MD) -->
      <div class="md:col-span-7 flex flex-col justify-between border-b md:border-b-0 md:border-r border-neutral-300 dark:border-neutral-800 px-4 sm:px-6 py-6 sm:py-8 lg:py-10 bg-white dark:bg-neutral-950">
        <div>
          <!-- Name + Subtitle Row -->
          <div>
            <div
              id="hero-typewriter"
              class="font-mono text-xs sm:text-sm text-neutral-400 dark:text-neutral-500 uppercase tracking-[0.2em] flex items-center min-h-6 mb-3 sm:mb-4 select-none"
              data-words='{{ (home.hero.eyebrowWords or ["developer & systems builder", "distributed systems enthusiast", "cloud infrastructure builder", "bca student & software engineer"]) | dump | escape }}'
              aria-label="developer & systems builder"
            >
              <span id="hero-typewriter-text">{{ home.hero.eyebrow or "developer & systems builder" }}</span><span class="typewriter-block-cursor" aria-hidden="true"></span>
            </div>
            <h1 class="font-heading font-bold text-[clamp(2.75rem,18.5vw,4.75rem)] md:text-7xl lg:text-[6.5rem] xl:text-[7.25rem] tracking-tight uppercase leading-none md:leading-[0.88] select-none my-3 sm:my-4 whitespace-nowrap md:whitespace-normal">
              <span
                class="inline md:block text-neutral-900 dark:text-neutral-100"
              >{{ home.hero.name or "SOUMIL SEAL" }}</span>
              <span
                class="inline md:block text-primary-600 dark:text-primary-400 ml-2 md:ml-0"
              ></span>
            </h1>
            <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mt-3 sm:mt-4 text-xs sm:text-sm font-mono text-neutral-500 dark:text-neutral-400 tracking-wide">
              <span>{{
                home.hero.location or "India // remote-friendly"
              }}</span>
              <span class="text-neutral-300 dark:text-neutral-700 font-mono">//</span>
              <span
                class="text-primary-600 dark:text-primary-400 font-medium"
              >{{
                home.hero.role or "BCA Undergraduate // Developer // Systems Builder"
              }}</span>
            </div>
          </div>

          <!-- Editorial Bio -->
          <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed sm:leading-[1.8] font-sans mt-6 sm:mt-8 max-w-xl">
            {{
              home.hero.bio or "I engineer software across distributed backend systems, cloud infrastructure, and modern web applications. Passionate about runtime internals, concurrency mechanics, clean architectural boundaries, and delivering reliable developer tools."
            }}
          </p>
        </div>

        <!-- Integrated Dual Action Buttons -->
        <div class="pt-6 sm:pt-8 mt-8 sm:mt-10 border-t border-neutral-200 dark:border-neutral-800/80 flex flex-wrap items-center gap-3.5">
          <a
            href="{{ home.hero.primaryCta.url or '/resume/' }}"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-900 hover:bg-neutral-800 text-white dark:bg-neutral-100 dark:hover:bg-white dark:text-neutral-900 font-mono text-xs font-semibold tracking-tight transition-all shadow-sm group"
          >
            <span>{{
              home.hero.primaryCta.text or 'View Resume & Credentials'
            }}</span>
            <span
              class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform flex items-center"
            >{{ icons.icon("arrow-up-right", "w-3.5 h-3.5") }}</span>
          </a>

          <a
            href="{{ home.hero.secondaryCta.url or '/projects/' }}"
            class="inline-flex items-center gap-2 px-4 py-2.5 border border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-500 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-50 dark:hover:bg-neutral-900/60 font-mono text-xs font-medium tracking-tight transition-all group"
          >
            <span>{{ home.hero.secondaryCta.text or 'Explore Projects' }} ({{
                collections.projects.length or 0
              }})</span>
            <span
              class="group-hover:translate-x-1 transition-transform flex items-center"
            >{{ icons.icon("arrow-right", "w-3.5 h-3.5") }}</span>
          </a>
        </div>
      </div>

      <!-- RIGHT SIDE: Full-Area Hero Portrait Image (replaces the 2 stacked text blocks) -->
      <div class="md:col-span-5 relative bg-neutral-950 overflow-hidden flex items-stretch border-t md:border-t-0 min-h-85 sm:min-h-100 md:min-h-full">
        <div class="relative w-full h-full flex-1 overflow-hidden group">
          <img
            src="{{ home.hero.image or '/assets/images/me.jpg' }}"
            alt="{{ home.hero.name or 'Soumil Seal' }}"
            class="w-full h-full object-cover object-center filter brightness-[0.98] contrast-[1.02]"
            loading="eager"
            width="800"
            height="800"
          />
          <div class="absolute inset-0 bg-linear-to-t from-neutral-950/70 via-transparent to-transparent pointer-events-none md:hidden">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Programming Languages Infinite GSAP Scroll (Contiguous Grid Section) -->
  <section
    class="border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950 relative"
    id="languages-marquee-section"
  >
    <!-- Section Header Bar -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
        {{ home.marquee.title or "languages-and-tooling" }}
      </h2>
      <span
        class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >
        {{ home.marquee.subtitle or "tech-stack // languages & tools" }}
      </span>
    </div>

    <!-- Infinite Scroll Wrapper -->
    <div
      id="languages-ticker-wrapper"
      class="overflow-hidden relative select-none w-full py-0 group"
    >
      <div
        id="languages-ticker-track"
        data-speed="{{ home.marquee.speed or 32 }}"
        class="flex items-stretch whitespace-nowrap w-max will-change-transform"
      >
        {% set marqueeItems = home.marquee.items %}
        {% if not marqueeItems or marqueeItems.length == 0 %}
          {%
            set marqueeItems = [
              { "name": "Python", "url": "https://www.python.org", "icon": "https://skillicons.dev/icons?i=py" },
              { "name": "TypeScript", "url": "https://www.typescriptlang.org", "icon": "https://skillicons.dev/icons?i=ts" },
              { "name": "JavaScript", "url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript", "icon": "https://skillicons.dev/icons?i=js" },
              { "name": "Go", "url": "https://go.dev", "icon": "https://skillicons.dev/icons?i=go" },
              { "name": "Rust", "url": "https://www.rust-lang.org", "icon": "https://skillicons.dev/icons?i=rust" },
              { "name": "C++", "url": "https://isocpp.org", "icon": "https://skillicons.dev/icons?i=cpp" },
              { "name": "C", "url": "https://en.cppreference.com/w/c", "icon": "https://skillicons.dev/icons?i=c" },
              { "name": "Java", "url": "https://www.oracle.com/java/", "icon": "https://skillicons.dev/icons?i=java" },
              { "name": "Node.js", "url": "https://nodejs.org", "icon": "https://skillicons.dev/icons?i=nodejs" },
              { "name": "Docker", "url": "https://www.docker.com", "icon": "https://skillicons.dev/icons?i=docker" },
              { "name": "Linux", "url": "https://www.kernel.org", "icon": "https://skillicons.dev/icons?i=linux" },
              { "name": "AWS", "url": "https://aws.amazon.com", "icon": "https://skillicons.dev/icons?i=aws" },
              { "name": "PostgreSQL", "url": "https://www.postgresql.org", "icon": "https://skillicons.dev/icons?i=postgres" },
              { "name": "Redis", "url": "https://redis.io", "icon": "https://skillicons.dev/icons?i=redis" },
              { "name": "SQLite", "url": "https://www.sqlite.org", "icon": "https://skillicons.dev/icons?i=sqlite" },
              { "name": "Bash / Shell", "url": "https://www.gnu.org/software/bash/", "icon": "https://skillicons.dev/icons?i=bash" },
              { "name": "Git", "url": "https://git-scm.com", "icon": "https://skillicons.dev/icons?i=git" },
              { "name": "Tailwind CSS", "url": "https://tailwindcss.com", "icon": "https://skillicons.dev/icons?i=tailwind" },
              { "name": "Nginx", "url": "https://nginx.org", "icon": "https://skillicons.dev/icons?i=nginx" },
              { "name": "Prometheus", "url": "https://prometheus.io", "icon": "https://skillicons.dev/icons?i=prometheus" }
            ]
          %}
        {% endif %}

        <!-- Group A -->
        <div class="languages-ticker-group flex items-stretch shrink-0">
          {% for item in marqueeItems %}
            <a
              href="{{ item.url or '#' }}"
              {% if item.url and item.url.startsWith('http') %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
              class="border-r border-neutral-300 dark:border-neutral-800 px-5 py-3 flex items-center gap-2.5 font-mono text-xs hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors group/item shrink-0 text-neutral-900 dark:text-neutral-100 focus:outline-none cursor-pointer"
            >
              {% set iconSrc = item.image or item.icon %}
              {% if iconSrc %}
                {% if not iconSrc.startsWith('http') and not iconSrc.startsWith('/') and not iconSrc.startsWith('.') %}
                  {% set iconSrc = 'https://skillicons.dev/icons?i=' + iconSrc %}
                {% endif %}
                <img
                  src="{{ iconSrc }}"
                  alt=""
                  class="w-5 h-5 object-contain shrink-0"
                  loading="lazy"
                  width="20"
                  height="20"
                />
              {% endif %}
              <span
                class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover/item:text-primary-600 dark:group-hover/item:text-primary-400 transition-colors"
              >{{ item.name }}</span>
            </a>
          {% endfor %}
        </div>

        <!-- Group B (Identical Clone for Seamless Infinite Loop) -->
        <div
          class="languages-ticker-group flex items-stretch shrink-0"
          aria-hidden="true"
        >
          {% for item in marqueeItems %}
            <a
              href="{{ item.url or '#' }}"
              {% if item.url and item.url.startsWith('http') %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
              tabindex="-1"
              class="border-r border-neutral-300 dark:border-neutral-800 px-5 py-3 flex items-center gap-2.5 font-mono text-xs hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors group/item shrink-0 text-neutral-900 dark:text-neutral-100 focus:outline-none cursor-pointer"
            >
              {% set iconSrc = item.image or item.icon %}
              {% if iconSrc %}
                {% if not iconSrc.startsWith('http') and not iconSrc.startsWith('/') and not iconSrc.startsWith('.') %}
                  {% set iconSrc = 'https://skillicons.dev/icons?i=' + iconSrc %}
                {% endif %}
                <img
                  src="{{ iconSrc }}"
                  alt=""
                  class="w-5 h-5 object-contain shrink-0"
                  loading="lazy"
                  width="20"
                  height="20"
                />
              {% endif %}
              <span
                class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover/item:text-primary-600 dark:group-hover/item:text-primary-400 transition-colors"
              >{{ item.name }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section (Contiguous Grid Section, Zero Outer Margins) -->
  <section>
    <!-- Section Header Bar -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ home.sections.featuredProjectsTitle or "featured-projects" }}
        </h2>
      </div>
      <a
        href="/projects/"
        class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors flex items-center gap-1.5"
      >
        <span>view all ({{ collections.projects.length or 0 }})</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>

    <!-- Contiguous Featured Projects Grid / Empty State -->
    {% if collections.projects.length > 0 %}
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-300 dark:divide-neutral-800 border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950">
        {% set featuredList = collections.featuredProjects if (collections.featuredProjects and collections.featuredProjects.length > 0) else collections.projects %}
        {% for project in featuredList %}
          {% if loop.index <= 3 %}
            {% include "components/project-card.njk" %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950 px-4 sm:px-6 py-12 sm:py-16 text-center">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xs border border-neutral-300 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/60 text-neutral-400 dark:text-neutral-500 mb-3">
          {{ icons.icon("code-slash", "w-4 h-4") }}
        </div>
        <p class="font-mono text-sm sm:text-base font-semibold text-neutral-800 dark:text-neutral-200 tracking-tight">
          No Projects Right now, Coming soon
        </p>
        <p class="font-mono text-xs text-neutral-400 dark:text-neutral-500 mt-1">
          // systems, distributed daemons & tools currently in development
        </p>
      </div>
    {% endif %}
  </section>

  <!-- Latest Writing Section (Contiguous Grid Section, Zero Outer Margins) -->
  <section>
    <!-- Section Header Bar -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ home.sections.writingTitle or "writing-and-notes" }}
        </h2>
      </div>
      <a
        href="/blog/"
        class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors flex items-center gap-1.5"
      >
        <span>all articles ({{ collections.posts.length or 0 }})</span>
        {{ icons.icon("arrow-right", "w-3 h-3") }}
      </a>
    </div>

    <!-- Contiguous Posts List / Empty State -->
    {% if collections.posts.length > 0 %}
      <div class="divide-y divide-neutral-300 dark:divide-neutral-800 border-b border-neutral-300 dark:border-neutral-800">
        {% for post in collections.posts | head(3) %}
          {% include "components/post-card.njk" %}
        {% endfor %}
      </div>
    {% else %}
      <div class="border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950 px-4 sm:px-6 py-12 sm:py-16 text-center">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xs border border-neutral-300 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/60 text-neutral-400 dark:text-neutral-500 mb-3">
          {{ icons.icon("journal-text", "w-4 h-4") }}
        </div>
        <p class="font-mono text-sm sm:text-base font-semibold text-neutral-800 dark:text-neutral-200 tracking-tight">
          No Blogs Right now, Coming soon
        </p>
        <p class="font-mono text-xs text-neutral-400 dark:text-neutral-500 mt-1">
          // technical deep dives & architecture notes queued for publishing
        </p>
      </div>
    {% endif %}
  </section>

  <!-- Contact Section (Contiguous Grid Section, Zero Outer Margins) -->
  <section>
    <!-- Section Header Bar -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          {{ home.sections.contactTitle or "get-in-touch" }}
        </h2>
      </div>
      <a
        href="/contact/"
        class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors flex items-center gap-1.5"
      >
        <span>contact page</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>

    <div class="px-4 sm:px-6 py-6 sm:py-8 space-y-6 bg-white dark:bg-neutral-950">
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans max-w-xl">
        {{
          home.sections.contactText or "I'm currently looking for software engineering internships and open-source collaborations. Feel free to connect via any channel below or submit a message through the contact form."
        }}
      </p>

      <form
        id="home-contact-form"
        class="contact-dispatch-form space-y-5 max-w-xl"
        action="{{ contact.form.action or 'https://api.web3forms.com/submit' }}"
        method="POST"
      >
        <input type="hidden" name="access_key" value="{{ contact.form.accessKey or 'ba639b9a-3fc5-4dfa-9576-acf24ea3f2da' }}">
        <div class="space-y-1.5">
          <label
            for="home-name"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            {{ contact.form.nameLabel or "name" }}
          </label>
          <input
            type="text"
            id="home-name"
            name="name"
            required
            placeholder="{{ contact.form.namePlaceholder or 'Jane Doe' }}"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors"
          >
        </div>

        <div class="space-y-1.5">
          <label
            for="home-email"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            {{ contact.form.emailLabel or "email-address" }}
          </label>
          <input
            type="email"
            id="home-email"
            name="email"
            required
            placeholder="{{ contact.form.emailPlaceholder or 'jane@example.com' }}"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors"
          >
        </div>

        <div class="space-y-1.5">
          <label
            for="home-message"
            class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
          >
            {{ contact.form.messageLabel or "message-payload" }}
          </label>
          <textarea
            id="home-message"
            name="message"
            rows="4"
            required
            placeholder="{{ contact.form.messagePlaceholder or 'Your message...' }}"
            class="w-full px-3.5 py-2.5 border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-white text-sm focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 transition-colors resize-y"
          ></textarea>
        </div>

        <div class="form-feedback hidden p-3.5 text-xs font-mono"></div>

        <div class="flex items-center gap-4 pt-1">
          <button
            type="submit"
            class="px-5 py-2.5 bg-primary-500 hover:bg-primary-600 text-neutral-950 font-mono text-xs font-bold tracking-tight transition-colors focus:outline-none flex items-center gap-2 group cursor-pointer"
          >
            <span>{{ contact.form.submitButtonText or "Send message" }}</span>
            <span
              class="group-hover:translate-x-1 transition-transform flex items-center"
            >{{ icons.icon("arrow-right", "w-3.5 h-3.5") }}</span>
          </button>

          <a
            href="/contact/"
            class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors flex items-center gap-1"
          >
            <span>open full contact page</span>
            {{ icons.icon("arrow-up-right", "w-3 h-3") }}
          </a>
        </div>
      </form>
    </div>

    <!-- Contiguous Channels Grid (Divide-X, Zero Outer Margins) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-neutral-300 dark:divide-neutral-800 border-t border-neutral-300 dark:border-neutral-800 text-xs font-mono bg-white dark:bg-neutral-950">
      <a
        href="/contact/"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Contact</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.github }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>GitHub</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.linkedin }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>LinkedIn</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.twitter }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Twitter/X</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>
  </section>
</div>
