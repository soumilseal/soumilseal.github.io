          </div>
          <div class="border-r border-neutral-300 dark:border-neutral-800 px-5 py-3 flex items-center gap-2 font-mono text-xs hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors">
            <span class="text-neutral-400 dark:text-neutral-500 text-[10px]"
            >14/</span>
            <span class="font-semibold text-neutral-900 dark:text-neutral-100"
            >Redis</span>
          </div>
        </div>

        <!-- Group B (Identical Clone for Seamless Infinite Loop) -->
        <div
          class="languages-ticker-group flex items-stretch shrink-0"
          aria-hidden="true"
        >
          <div class="border-r border-neutral-300 dark:border-neutral-800 px-5 py-3 flex items-center gap-2 font-mono text-xs hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors">
            <span class="text-neutral-400 dark:text-neutral-500 text-[10px]"
