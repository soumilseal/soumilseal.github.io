  <!-- Featured Projects Section (Contiguous Grid Section, Zero Outer Margins) -->
  <section>
    <!-- Section Header Bar -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          featured-projects/
        </h2>
      </div>
      <a
        href="/projects/"
        class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors flex items-center gap-1.5"
      >
        <span>view all ({{ projects.length }})</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>

    <!-- Contiguous Featured Projects Grid (3 Columns on Desktop, Zero Gaps) -->
    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-neutral-300 dark:divide-neutral-800 border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950">
      {% for project in projects %}
        {% if project.featured %}
          {% include "components/project-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <!-- Latest Writing Section (Contiguous Grid Section, Zero Outer Margins) -->
  <section>
    <!-- Section Header Bar -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          writing-and-notes/
        </h2>
      </div>
      <a
        href="/blog/"
        class="font-mono text-xs text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors flex items-center gap-1.5"
      >
        <span>all articles ({{ collections.posts.length }})</span>
        {{ icons.icon("arrow-right", "w-3 h-3") }}
      </a>
    </div>

    <!-- Contiguous Posts List (Divide-Y, Zero Left/Right Margins) -->
    <div class="divide-y divide-neutral-300 dark:divide-neutral-800 border-b border-neutral-300 dark:border-neutral-800">
      {% for post in collections.posts | head(3) %}
        {% include "components/post-card.njk" %}
      {% endfor %}
    </div>
  </section>

  <!-- Quiet Contact Section (Contiguous Grid Section, Zero Outer Margins) -->
  <section>
    <!-- Section Header Bar -->
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between relative">
      <div class="flex items-center gap-2">
        <h2 class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-neutral-900 dark:text-neutral-100 uppercase">
          get-in-touch/
        </h2>
      </div>
      <span
        class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500"
      >
        dispatch direct messages
      </span>
    </div>

    <div class="p-6 sm:p-8 space-y-4">
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans max-w-xl">
        I'm currently looking for software engineering internships and
        open-source collaborations. Feel free to send an email at <a
          href="mailto:{{ site.email }}"
          class="text-neutral-900 dark:text-neutral-100 underline underline-offset-4 font-medium"
        >{{ site.email }}</a> or reach out via any channel below.
      </p>
    </div>

    <!-- Contiguous Channels Grid (Divide-X, Zero Outer Margins) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-neutral-300 dark:divide-neutral-800 border-t border-neutral-300 dark:border-neutral-800 text-xs font-mono">
      <a
        href="mailto:{{ site.email }}"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Email</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.github }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>GitHub</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.linkedin }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>LinkedIn</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
      <a
        href="{{ site.twitter }}"
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 text-center hover:bg-neutral-100 dark:hover:bg-neutral-900/60 transition-colors flex items-center justify-center gap-1.5 font-medium text-neutral-900 dark:text-neutral-100"
      >
        <span>Twitter/X</span>
        {{ icons.icon("arrow-up-right", "w-3 h-3") }}
      </a>
    </div>
  </section>
</div>
