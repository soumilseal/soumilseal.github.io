---
layout: layouts/base.njk
title: Soumil Seal — Developer & BCA Student
description: Personal portfolio and technical blog of Soumil Seal. Focused on software development, cloud infrastructure, and modern web engineering.
---
{% import "components/icons.njk" as icons %}

<div class="max-w-3xl mx-auto px-6 sm:px-8 py-16 sm:py-24 space-y-20 sm:space-y-28">
  
  <!-- Hero Section -->
  <section class="space-y-6 pt-4">
    <div class="space-y-2">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Soumil Seal
      </h1>
      <p class="text-base sm:text-lg text-neutral-500 dark:text-neutral-400 font-mono">
        Developer & BCA Student
      </p>
    </div>

    <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
      I build software across backend systems, cloud infrastructure, and web applications. Passionate about understanding runtime mechanics, writing clean code, and shipping dependable tools.
    </p>

    <!-- Navigation Shortcuts -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-2 text-sm text-neutral-500 dark:text-neutral-400">
      <a href="/projects/" class="text-neutral-900 dark:text-neutral-100 font-medium hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
        Projects &rarr;
      </a>
      <a href="/blog/" class="text-neutral-900 dark:text-neutral-100 font-medium hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
        Writing &rarr;
      </a>
      <a href="/about/" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        About
      </a>
      <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        GitHub
      </a>
      <a href="mailto:{{ site.email }}" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        Email
      </a>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="space-y-8">
    <div class="flex items-baseline justify-between border-b border-neutral-200/60 dark:border-neutral-800/60 pb-3">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Featured Projects
      </h2>
      <a href="/projects/" class="text-xs font-mono text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        View all ({{ projects.length }}) &rarr;
      </a>
    </div>

    <div class="space-y-4">
      {% for project in projects %}
        {% if project.featured %}
          {% include "components/project-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <!-- Latest Writing Section -->
  <section class="space-y-8">
    <div class="flex items-baseline justify-between border-b border-neutral-200/60 dark:border-neutral-800/60 pb-3">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Writing & Notes
      </h2>
      <a href="/blog/" class="text-xs font-mono text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        All articles &rarr;
      </a>
    </div>

    <div class="divide-y divide-neutral-200/60 dark:divide-neutral-800/60">
      {% for post in collections.posts | head(3) %}
        {% include "components/post-card.njk" %}
      {% endfor %}
    </div>
  </section>

  <!-- Quiet Contact Note -->
  <section class="space-y-3 pt-6 border-t border-neutral-200/60 dark:border-neutral-800/60">
    <h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      Get in touch
    </h2>
    <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-xl">
      I'm currently looking for software engineering internships and open-source collaborations. Feel free to send an email at <a href="mailto:{{ site.email }}" class="text-neutral-900 dark:text-neutral-100 underline underline-offset-4 font-medium">{{ site.email }}</a> or find me on <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">GitHub</a> and <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">LinkedIn</a>.
    </p>
  </section>

</div>
