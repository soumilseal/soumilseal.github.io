---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
layout: layouts/page.njk
eleventyComputed:
  title: "Topic: #{{ tag }}"
  description: "Browse all articles, notes, and tutorials filed under the {{ tag }} topic."
permalink: /tags/{{ tag | slugify }}/
---
{% import "components/icons.njk" as icons %}

<div>
  <!-- Back navigation bar -->
  <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 px-6 sm:px-8 py-3">
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors">
      {{ icons.icon("arrow-left", "w-3 h-3") }}
      <span>back to all articles/</span>
    </a>
  </div>

  <!-- Contiguous Tag Posts List -->
  <div class="divide-y divide-neutral-300 dark:divide-neutral-800 border-b border-neutral-300 dark:border-neutral-800">
    {% set taglist = collections[tag] %}
    {% for post in taglist | reverse %}
      {% include "components/post-card.njk" %}
    {% else %}
      <div class="p-12 text-center text-sm font-mono text-neutral-400">
        No posts found with this tag.
      </div>
    {% endfor %}
  </div>
</div>
