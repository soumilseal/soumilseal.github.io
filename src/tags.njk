---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
layout: layouts/page.njk
eleventyComputed:
  title: "Topic: #{{ tag }}"
  description: "Browse all articles, notes, and tutorials filed under the {{ tag }} topic."
permalink: /tags/{{ tag | slugify }}/
---
{% import "components/icons.njk" as icons %}

<div class="space-y-8">
  <div>
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
      {{ icons.icon("arrow-left", "w-3 h-3") }}
      <span>All articles</span>
    </a>
  </div>

  <div class="divide-y divide-neutral-200/60 dark:divide-neutral-800/60">
    {% set taglist = collections[tag] %}
    {% for post in taglist | reverse %}
      {% include "components/post-card.njk" %}
    {% else %}
      <div class="py-12 text-center text-sm font-mono text-neutral-400">
        No posts found with this tag.
      </div>
    {% endfor %}
  </div>
</div>
