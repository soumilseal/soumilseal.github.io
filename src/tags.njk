---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
layout: layouts/page.njk
eleventyComputed:
  title: "Articles tagged #{{ tag }}"
  description: "Browse all articles and notes filed under the {{ tag }} topic."
permalink: /tags/{{ tag | slugify }}/
---
{% import "components/icons.njk" as icons %}

<div class="space-y-8">
  <div>
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
      {{ icons.icon("arrow-left", "w-3 h-3") }}
      <span>View all topics &amp; articles</span>
    </a>
  </div>

  <section class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start">
    <div class="sm:col-span-3">
      <h2 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">
        #{{ tag }}
      </h2>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 font-mono mt-1 hidden sm:block">
        Topic archive
      </p>
    </div>

    <div class="sm:col-span-9 space-y-7 w-full">
      {% set taglist = collections[tag] %}
      {% for post in taglist | reverse %}
        <article class="space-y-1.5 pb-6 border-b border-neutral-100 dark:border-neutral-800/80 last:border-0 group">
          <div class="flex flex-wrap items-baseline gap-2">
            <h3 class="text-sm sm:text-base font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
              <a href="{{ post.url }}">
                {{ post.data.title }}
              </a>
            </h3>
            <span class="text-xs font-normal text-neutral-400 dark:text-neutral-500 font-mono">
              {{ post.templateContent | readingTime }}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {{ post.data.description }}
          </p>

          <div class="flex items-center justify-between pt-1 text-[11px] font-mono text-neutral-400 dark:text-neutral-500">
            <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
            <a href="{{ post.url }}" class="inline-flex items-center gap-1 text-accent-600 dark:text-accent-400 hover:underline">
              <span>Read</span>
              {{ icons.icon("arrow-right", "w-2.5 h-2.5") }}
            </a>
          </div>
        </article>
      {% else %}
        <div class="py-12 text-center text-xs text-neutral-400 font-mono">
          No posts found with this tag.
        </div>
      {% endfor %}
    </div>
  </section>
</div>
