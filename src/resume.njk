---
layout: layouts/base.njk
title: Resume — Soumil Seal
description: Curriculum Vitae and technical resume of Soumil Seal — Software design, cloud systems, and web architecture.
permalink: /resume/
---
{% import "components/icons.njk" as icons %}

<div class="resume-sheet divide-y divide-neutral-200/80 dark:divide-neutral-800/80 pt-2" data-pagefind-body>

  <!-- Top Utilities: Back & Print Button (Hidden on Print) -->
  <div class="no-print flex items-center justify-between pb-6 text-xs font-mono">
    <a href="/" class="inline-flex items-center gap-1.5 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
      {{ icons.icon("arrow-left", "w-3 h-3") }}
      <span>Back to overview</span>
    </a>

    <button type="button" 
            onclick="window.print()" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-200/90 bg-neutral-50 hover:bg-neutral-100 text-neutral-800 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 transition-colors shadow-2xs cursor-pointer">
      {{ icons.icon("printer", "w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400") }}
      <span>Print / Save PDF</span>
    </button>
  </div>

  <!-- Header: Name on Left, Contact Details on Right (Matching Reference) -->
  <header class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start py-8">
    <div class="sm:col-span-3 sm:border-r border-neutral-200/80 dark:border-neutral-800/80 sm:pr-4">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        {{ resume.name }}
      </h1>
      <p class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 mt-1">
        Curriculum Vitae
      </p>
    </div>

    <div class="sm:col-span-9 sm:pl-2 space-y-1 text-xs text-neutral-600 dark:text-neutral-400 font-mono leading-relaxed">
      <div>
        <a href="{{ resume.websiteUrl }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {{ resume.website }}
        </a>
      </div>
      <div>
        <a href="mailto:{{ resume.email }}" class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {{ resume.email }}
        </a>
      </div>
      <div>
        <a href="{{ resume.githubUrl }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {{ resume.github }}
        </a>
      </div>
      <div>
        <a href="{{ resume.linkedinUrl }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-white transition-colors">
          {{ resume.linkedin }}
        </a>
      </div>
      <div class="text-neutral-400 dark:text-neutral-500 pt-0.5">
        {{ resume.location }}
      </div>
    </div>
  </header>

  <!-- Section: Experience -->
  <section class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start py-8">
    <div class="sm:col-span-3 sm:border-r border-neutral-200/80 dark:border-neutral-800/80 sm:pr-4">
      <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        Experience
      </h2>
      <p class="text-[11px] font-mono text-neutral-400 dark:text-neutral-600 mt-1 hidden sm:block">
        Roles &amp; Impact
      </p>
    </div>

    <div class="sm:col-span-9 sm:pl-2 space-y-8">
      {% for exp in resume.experience %}
        <div class="space-y-1.5">
          <div class="flex flex-wrap items-baseline gap-2">
            <h3 class="text-sm sm:text-base font-bold text-neutral-900 dark:text-neutral-100">
              {{ exp.company }}
            </h3>
            <span class="text-sm font-normal text-neutral-400 dark:text-neutral-500">
              {{ exp.role }}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {{ exp.description }}
          </p>

          <div class="text-xs text-neutral-400 dark:text-neutral-500 font-normal pt-0.5 font-mono">
            {{ exp.period }} &middot; {{ exp.location }}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- Section: Skills (4-Column Layout in Bordered Grid Matrix) -->
  <section class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start py-8">
    <div class="sm:col-span-3 sm:border-r border-neutral-200/80 dark:border-neutral-800/80 sm:pr-4">
      <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        Skills
      </h2>
      <p class="text-[11px] font-mono text-neutral-400 dark:text-neutral-600 mt-1 hidden sm:block">
        Technical domain
      </p>
    </div>

    <div class="sm:col-span-9 sm:pl-2">
      <div class="grid grid-cols-2 sm:grid-cols-4 border border-neutral-200/80 dark:border-neutral-800/80 divide-x divide-y sm:divide-y-0 divide-neutral-200/80 dark:divide-neutral-800/80 rounded-lg overflow-hidden bg-neutral-50/40 dark:bg-neutral-900/40">
        {% for col in resume.skills %}
          <div class="p-3.5 space-y-2">
            <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
              {{ col.category }}
            </h3>
            <ul class="space-y-1 text-xs text-neutral-700 dark:text-neutral-300">
              {% for skill in col.items %}
                <li class="leading-relaxed">{{ skill }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Section: Education -->
  <section class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start py-8">
    <div class="sm:col-span-3 sm:border-r border-neutral-200/80 dark:border-neutral-800/80 sm:pr-4">
      <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        Education
      </h2>
      <p class="text-[11px] font-mono text-neutral-400 dark:text-neutral-600 mt-1 hidden sm:block">
        Academic history
      </p>
    </div>

    <div class="sm:col-span-9 sm:pl-2 space-y-2">
      <div class="flex flex-wrap items-baseline gap-2">
        <h3 class="text-sm sm:text-base font-bold text-neutral-900 dark:text-neutral-100">
          {{ resume.education.institution }}
        </h3>
        <span class="text-sm font-normal text-neutral-400 dark:text-neutral-500">
          {{ resume.education.classYear }}
        </span>
      </div>

      <p class="text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
        {{ resume.education.degree }}<br>
        <span class="text-neutral-500 dark:text-neutral-400">{{ resume.education.focus }}</span>
      </p>

      {% if resume.education.gpa %}
        <p class="text-xs text-neutral-400 dark:text-neutral-500 pt-0.5 font-mono">
          {{ resume.education.gpa }}
        </p>
      {% endif %}

      <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed pt-1">
        {{ resume.education.details }}
      </p>
    </div>
  </section>

  <!-- Section: Honors -->
  <section class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start py-8 last:pb-2">
    <div class="sm:col-span-3 sm:border-r border-neutral-200/80 dark:border-neutral-800/80 sm:pr-4">
      <h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        Honors
      </h2>
      <p class="text-[11px] font-mono text-neutral-400 dark:text-neutral-600 mt-1 hidden sm:block">
        Achievements
      </p>
    </div>

    <div class="sm:col-span-9 sm:pl-2 space-y-2 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed">
      {% for honor in resume.honors %}
        <div>{{ honor }}</div>
      {% endfor %}
    </div>
  </section>

</div>
