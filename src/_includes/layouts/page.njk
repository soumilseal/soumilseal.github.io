---
layout: layouts/base.njk

---
{% import "components/icons.njk" as icons %}

<div class="max-w-[950px] w-full mx-auto border-x border-neutral-300 dark:border-neutral-800 relative bg-white dark:bg-neutral-950 grow flex flex-col">
  {% if title %}
    <header class="page-header-aurora relative px-6 sm:px-8 py-8 sm:py-12 border-b border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-950 shrink-0 overflow-hidden">
      {% include "components/page-aurora.njk" %}
      <div class="relative z-10 space-y-3">
        <div class="inline-flex items-center font-mono text-xs font-bold text-neutral-900 dark:text-neutral-100 uppercase tracking-widest bg-white/75 dark:bg-neutral-900/75 backdrop-blur-md px-2.5 py-1 border border-neutral-300/80 dark:border-neutral-700/80 rounded-xs shadow-xs w-fit">
          <span>section // {{ title | lower }}</span>
        </div>
        <h1 class="font-heading font-bold text-4xl sm:text-6xl text-neutral-900 dark:text-neutral-100 uppercase tracking-tight">
          {{ title }}
        </h1>
        {% if description %}
          <p class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed max-w-2xl font-sans">
            {{ description }}
          </p>
        {% endif %}
      </div>
    </header>
  {% endif %}

  <div class="page-content grow flex flex-col">
    {{ content | safe }}
  </div>
</div>
