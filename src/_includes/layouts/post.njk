---
layout: layouts/base.njk
---
{% import "components/icons.njk" as icons %}

<article class="max-w-3xl mx-auto px-6 sm:px-8 py-16 sm:py-24 border-x border-neutral-200/80 dark:border-neutral-800/80 relative bg-white dark:bg-[#160606]" data-pagefind-body>
  <!-- Back link -->
  <div class="mb-10">
    <a href="/blog/" class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-neutral-200/80 dark:border-neutral-800/80 text-xs font-mono text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors">
      {{ icons.icon("arrow-left", "w-3 h-3") }}
      <span>All articles</span>
    </a>
  </div>

  <!-- Article Header with Vercel Gridline Divider -->
  <header class="relative mb-12 pb-8 border-b border-neutral-200/80 dark:border-neutral-800/80 space-y-4">
    {{ icons.vercel_plus("bl") }}
    {{ icons.vercel_plus("br") }}

    <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
      <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      <span>&bull;</span>
      <span>{{ content | readingTime }}</span>
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 leading-tight">
      {{ title }}
    </h1>

    {% if description %}
      <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
        {{ description }}
      </p>
    {% endif %}

    {% if tags %}
      <div class="flex flex-wrap gap-2 pt-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
        {% for tag in tags | filterTagList %}
          <a href="/tags/{{ tag | slugify }}/" class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">
            #{{ tag }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <!-- Article Content -->
  <div class="prose prose-neutral dark:prose-invert max-w-none text-[16px] sm:text-[17px] leading-relaxed">
    {{ content | safe }}
  </div>

  <!-- Article Footer with Vercel Gridlines -->
  <footer class="relative mt-16 pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80 space-y-8">
    {{ icons.vercel_plus("tl") }}
    {{ icons.vercel_plus("tr") }}

    <div class="text-xs text-neutral-500 dark:text-neutral-400 space-y-1 font-mono">
      <p>Written by <strong class="text-neutral-900 dark:text-neutral-100">Soumil Seal</strong> &bull; Developer & BCA Student</p>
      <p>Questions or feedback? <a href="mailto:{{ site.email }}" class="underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100">Send an email</a>.</p>
    </div>

    <!-- Prev / Next Navigation -->
    {% set previousPost = collections.posts | getPreviousCollectionItem %}
    {% set nextPost = collections.posts | getNextCollectionItem %}
    {% if previousPost or nextPost %}
      <nav class="relative flex items-center justify-between text-xs font-mono pt-6 border-t border-neutral-200/60 dark:border-neutral-800/60">
        <div>
          {% if previousPost %}
            <a href="{{ previousPost.url }}" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
              &larr; {{ previousPost.data.title }}
            </a>
          {% endif %}
        </div>
        <div>
          {% if nextPost %}
            <a href="{{ nextPost.url }}" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
              {{ nextPost.data.title }} &rarr;
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
  </footer>
</article>
