---
layout: layouts/base.njk
---
{% import "components/icons.njk" as icons %}

{% include "components/profile-header.njk" %}

<article class="w-full space-y-8" data-pagefind-body>
  <!-- Navigation Back Link -->
  <div>
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
      {{ icons.icon("arrow-left", "w-3 h-3") }}
      <span>Back to all posts</span>
    </a>
  </div>

  <!-- Post Header -->
  <header class="space-y-3 pb-6 border-b border-neutral-200/80 dark:border-neutral-800/80">
    <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-neutral-400 dark:text-neutral-500">
      <span class="inline-flex items-center gap-1">
        {{ icons.icon("calendar", "w-3 h-3 text-neutral-400") }}
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      </span>
      {% if updated %}
        <span>&bull;</span>
        <span class="italic text-neutral-400">Updated: {{ updated | readableDate }}</span>
      {% endif %}
      <span>&bull;</span>
      <span class="inline-flex items-center gap-1">
        {{ icons.icon("clock", "w-3 h-3 text-neutral-400") }}
        <span>{{ content | readingTime }}</span>
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 leading-tight">
      {{ title }}
    </h1>

    {% if description %}
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        {{ description }}
      </p>
    {% endif %}

    {% if tags %}
      <div class="flex flex-wrap gap-1.5 pt-2">
        {% for tag in tags | filterTagList %}
          <a href="/tags/{{ tag | slugify }}/" class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-600 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 transition-colors">
            {{ tag }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <!-- Post Body Content -->
  <div class="prose prose-neutral dark:prose-invert max-w-none text-[15px] sm:text-[16px] leading-relaxed">
    {{ content | safe }}
  </div>

  <!-- Post Footer & Author -->
  <footer class="mt-12 pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80 space-y-8">
    <div class="p-4 rounded-xl border border-neutral-200/80 bg-neutral-50/70 dark:border-neutral-800 dark:bg-neutral-900/60 flex items-center justify-between gap-4">
      <div class="space-y-1">
        <p class="text-xs font-semibold text-neutral-900 dark:text-neutral-100">Written by Soumil Seal</p>
        <p class="text-[11px] text-neutral-500 dark:text-neutral-400">Developer &amp; BCA student exploring software design &amp; cloud systems.</p>
      </div>
      <a href="/contact/" class="text-xs font-mono text-accent-600 dark:text-accent-400 hover:underline shrink-0 inline-flex items-center gap-1">
        <span>Get in touch</span>
        {{ icons.icon("arrow-right", "w-2.5 h-2.5") }}
      </a>
    </div>

    <!-- Prev / Next Post Links -->
    {% set previousPost = collections.posts | getPreviousCollectionItem %}
    {% set nextPost = collections.posts | getNextCollectionItem %}
    {% if previousPost or nextPost %}
      <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs font-mono" aria-label="Adjacent Articles">
        <div>
          {% if previousPost %}
            <a href="{{ previousPost.url }}" class="group block p-3 rounded-lg border border-neutral-200/70 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
              <span class="text-neutral-400 dark:text-neutral-500 flex items-center gap-1 mb-1">
                {{ icons.icon("arrow-left", "w-2.5 h-2.5") }}
                <span>Previous</span>
              </span>
              <span class="font-medium text-neutral-800 dark:text-neutral-200 line-clamp-1 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                {{ previousPost.data.title }}
              </span>
            </a>
          {% endif %}
        </div>
        <div>
          {% if nextPost %}
            <a href="{{ nextPost.url }}" class="group block p-3 rounded-lg border border-neutral-200/70 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors text-right">
              <span class="text-neutral-400 dark:text-neutral-500 flex items-center justify-end gap-1 mb-1">
                <span>Next</span>
                {{ icons.icon("arrow-right", "w-2.5 h-2.5") }}
              </span>
              <span class="font-medium text-neutral-800 dark:text-neutral-200 line-clamp-1 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                {{ nextPost.data.title }}
              </span>
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}
  </footer>
</article>
