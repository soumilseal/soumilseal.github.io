---
layout: layouts/base.njk

---
{% import "components/icons.njk" as icons %}

<article
  class="max-w-[950px] mx-auto border-x border-b border-neutral-300 dark:border-neutral-800 relative bg-white dark:bg-neutral-950"
  data-pagefind-body
>
  <!-- Back Navigation Bar: Contiguous Grid Row -->
  <div class="px-4 sm:px-6 py-1.5 border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40 flex items-center justify-between">
    <a
      href="/blog/"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors"
    >
      {{ icons.icon("arrow-left", "w-3 h-3") }}
      <span>back to articles/</span>
    </a>
    <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">{{
      content | readingTime
    }}</span>
  </div>

  <!-- Article Header: Contiguous Grid Row -->
  <header class="px-6 sm:px-8 py-8 sm:py-12 border-b border-neutral-300 dark:border-neutral-800 space-y-4 bg-white dark:bg-neutral-950 relative">
    <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
      <time datetime="{{ date | htmlDateString }}">{{
        date | readableDate
      }}</time>
      <span>&bull;</span>
      <span class="text-primary-600 dark:text-primary-400 font-medium"
      >technical note</span>
    </div>

    <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl text-neutral-900 dark:text-neutral-100 uppercase tracking-tight leading-tight">
      {{ title }}
    </h1>

    {% if description %}
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl font-sans">
        {{ description }}
      </p>
    {% endif %}

    {% if tags %}
      <div class="flex flex-wrap gap-1.5 pt-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
        {% for tag in tags | filterTagList %}
          <a
            href="/tags/{{ tag | slugify }}/"
            class="grid-badge hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors"
          >
            #{{ tag }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <!-- Article Cover Exhibit: Contiguous Grid Row -->
  {% if image %}
    <div class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-950 overflow-hidden relative">
      <div class="px-6 sm:px-8 py-2 border-b border-neutral-300 dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-900 flex items-center justify-between text-[11px] font-mono text-neutral-600 dark:text-neutral-400">
        <span>schematic // technical_exhibit_01</span>
        <span class="text-neutral-400 dark:text-neutral-500">figure.arch</span>
      </div>
      <div class="max-h-[460px] overflow-hidden flex items-center justify-center bg-neutral-950">
        <img
          src="{{ image }}"
          alt="{{ title }}"
          class="w-full h-auto object-cover max-h-[460px]"
        />
      </div>
    </div>
  {% endif %}

  <!-- Article Prose Content -->
  <div class="px-6 sm:px-8 py-10 sm:py-14 bg-white dark:bg-neutral-950">
    <div class="prose prose-neutral dark:prose-invert max-w-none text-[16px] sm:text-[17px] leading-relaxed">
      {{ content | safe }}
    </div>
  </div>

  <!-- Article Footer: Contiguous Grid Row -->
  <footer class="border-t border-neutral-300 dark:border-neutral-800 px-6 sm:px-8 py-8 space-y-4 bg-neutral-50/50 dark:bg-neutral-900/30">
    <div class="text-xs text-neutral-500 dark:text-neutral-400 space-y-1 font-mono">
      <p>
        Written by <strong class="text-neutral-900 dark:text-neutral-100"
        >Soumil Seal</strong> &bull; Developer & BCA Student
      </p>
      <p>
        Questions or feedback? <a
          href="mailto:{{ site.email }}"
          class="inline-flex items-center gap-1.5 underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100"
        >
          <span>Send an email</span>
          {{ icons.icon("arrow-up-right", "w-3 h-3") }}
        </a>
      </p>
    </div>
  </footer>
</article>
