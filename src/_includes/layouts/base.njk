<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">

    <!-- Head Scripts: Theme FOUC Prevention + Banner Dismissal + Font Load Check -->
    <script>
    (function() {
  try {
    const theme = localStorage.getItem("hs_theme")
      || localStorage.getItem("color-scheme");
    const isDark = theme === "dark"
      || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
    if (isDark) {
      document.documentElement.classList.add("dark");
      const meta = document.querySelector("meta[name=\"color-scheme\"]");
      if (meta) meta.content = "dark";
    }

    if (localStorage.getItem("hide_ticker_banner") === "true") {
      document.documentElement.classList.add("hide-ticker");
    }

    if ("fonts" in document) {
      document.documentElement.classList.add("wf-loading");
      document.fonts.ready.then(function() {
        document.documentElement.classList.remove("wf-loading");
        document.documentElement.classList.add("wf-active");
      });
      setTimeout(function() {
        document.documentElement.classList.remove("wf-loading");
        document.documentElement.classList.add("wf-active");
      }, 1200);
    }
  } catch (e) {}
})();
    </script>

    <title>
      {% if title and title != site.name %}{{ title }} — {{ site.name }}{%
        else
      %}{{ site.title }}{% endif %}
    </title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="author" content="{{ site.author }}">

    <!-- Canonical and Feeds -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link
      rel="alternate"
      type="application/atom+xml"
      title="{{ site.name }} Feed"
      href="/feed.xml"
    >

    <!-- OpenGraph / Social Meta -->
    <meta
      property="og:title"
      content="{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}"
    >
    <meta
      property="og:description"
      content="{{ description or site.description }}"
    >
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta
      property="og:type"
      content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}"
    >
    <meta name="twitter:card" content="summary_large_image">
    <meta
      name="twitter:title"
      content="{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}"
    >
    <meta
      name="twitter:description"
      content="{{ description or site.description }}"
    >

    <!-- Typography: Archivo, BenchNine & Geist Mono (display=block to load fonts before page renders) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=BenchNine:wght@400;700&family=Geist+Mono:wght@100..900&display=block"
    >
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=BenchNine:wght@400;700&family=Geist+Mono:wght@100..900&display=block"
      rel="stylesheet"
    >

    <!-- Main CSS (Tailwind v4 + Preline UI) -->
    <link rel="stylesheet" href="/assets/css/main.css">
  </head>
  <body class="flex flex-col min-h-screen relative overflow-x-hidden bg-white dark:bg-neutral-950">
    <!-- Ambient Blue Aura Beam -->
    <div class="site-aura" aria-hidden="true"></div>
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-accent-600 text-white shadow-lg font-medium text-sm focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Global Header -->
    {% include "components/header.njk" %}

    <!-- Background Grid & Interactive Cursor Trail (Starts strictly below the navbar) -->
    <div
      id="bg-grid-container"
      class="fixed inset-x-0 bottom-0 pointer-events-none z-0 overflow-hidden"
      style="top: var(--header-bottom, 56px);"
      aria-hidden="true"
    >
      <canvas id="bg-grid-canvas" class="w-full h-full block"></canvas>
    </div>

    <!-- Main Content Container -->
    <main id="main-content" class="grow flex flex-col relative z-10">
      {{ content | safe }}
    </main>

    <!-- Global Footer -->
    {% include "components/footer.njk" %}

    <!-- Search Modal (Pagefind Integration) -->
    {% include "components/search-modal.njk" %}

    <!-- Scripts -->
    <script src="/assets/js/preline.js"></script>
    <script src="/assets/js/gsap.min.js"></script>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/search.js"></script>
  </body>
</html>
