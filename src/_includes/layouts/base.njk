{% import "components/icons.njk" as icons %}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">

  <!-- FOUC Prevention Script -->
  <script>
    (function () {
      try {
        const theme = localStorage.getItem('hs_theme') || localStorage.getItem('color-scheme');
        const isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = 'dark';
        }
      } catch (e) {}
    })();
  </script>

  <title>{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">

  <!-- Canonical and Feeds -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Feed" href="/feed.xml">

  <!-- OpenGraph / Social Meta -->
  <meta property="og:title" content="{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
  <meta name="twitter:description" content="{{ description or site.description }}">

  <!-- Typography: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Main CSS (Tailwind v4 + Preline UI) -->
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body class="bg-white text-neutral-900 antialiased dark:bg-[#0b0f19] dark:text-neutral-100 flex flex-col min-h-screen">
  <!-- Accessibility Skip Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-neutral-900 text-white rounded-lg shadow-lg font-medium text-xs focus:outline-none dark:bg-white dark:text-black">
    Skip to main content
  </a>

  <!-- Mobile Top Bar with Side Navigation Trigger (Hidden on Desktop) -->
  <header class="md:hidden sticky top-0 z-40 w-full bg-white/95 dark:bg-[#0b0f19]/95 backdrop-blur border-b border-neutral-200/80 dark:border-neutral-800/80 px-4 py-2.5 flex items-center justify-between no-print">
    <a href="/" class="flex items-center gap-2 font-bold text-sm text-neutral-900 dark:text-white">
      <img src="/assets/images/me.jpg" alt="Soumil Seal" class="w-6 h-6 rounded-full object-cover border border-neutral-200 dark:border-neutral-700">
      <span>Soumil Seal</span>
    </a>

    <div class="flex items-center gap-1">
      <button type="button" 
              data-hs-overlay="#search-modal"
              class="p-2 rounded-lg text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white focus:outline-none cursor-pointer"
              aria-label="Search">
        {{ icons.icon("search", "w-4 h-4") }}
      </button>

      <button type="button" 
              class="theme-toggle-btn p-2 rounded-lg text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white focus:outline-none cursor-pointer" 
              aria-label="Toggle theme">
        <span class="dark:hidden">{{ icons.icon("moon", "w-4 h-4") }}</span>
        <span class="hidden dark:inline">{{ icons.icon("sun", "w-4 h-4") }}</span>
      </button>

      <!-- Side Nav Drawer Trigger for Mobile -->
      <button type="button" 
              data-hs-overlay="#mobile-sidebar"
              class="p-2 rounded-lg text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white focus:outline-none cursor-pointer"
              aria-label="Open side navigation menu">
        {{ icons.icon("list", "w-5 h-5") }}
      </button>
    </div>
  </header>

  <!-- Mobile Side Navigation Drawer (Offcanvas) -->
  <div id="mobile-sidebar" 
       class="hs-overlay hs-overlay-open:translate-x-0 hidden -translate-x-full fixed top-0 start-0 bottom-0 z-60 w-64 bg-white dark:bg-[#0e1424] border-e border-neutral-200/90 dark:border-neutral-800 transition-all duration-300 transform p-6 flex flex-col justify-between md:hidden" 
       tabindex="-1" 
       aria-label="Mobile Side Navigation">
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-neutral-100 dark:border-neutral-800">
        <div class="flex items-center gap-2">
          <img src="/assets/images/me.jpg" alt="Soumil Seal" class="w-7 h-7 rounded-full object-cover">
          <div>
            <div class="font-bold text-sm text-neutral-900 dark:text-white leading-tight">Soumil Seal</div>
            <div class="text-[10px] text-neutral-400 font-mono">Developer &amp; BCA Student</div>
          </div>
        </div>
        <button type="button" 
                class="size-8 inline-flex justify-center items-center rounded-lg text-neutral-400 hover:text-neutral-800 dark:hover:text-white cursor-pointer"
                data-hs-overlay="#mobile-sidebar">
          {{ icons.icon("x", "w-4 h-4") }}
        </button>
      </div>

      <nav class="space-y-3 text-sm">
        <div>
          <a href="/" class="flex items-center gap-2 transition-colors {% if page.url == '/' %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white " + ("" if page.url == '/' else "opacity-0")) }}
            <span>Home</span>
          </a>
        </div>
        <div>
          <a href="/projects/" class="flex items-center gap-2 transition-colors {% if '/projects/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white " + ("" if '/projects/' in page.url else "opacity-0")) }}
            <span>Projects</span>
          </a>
        </div>
        <div>
          <a href="/blog/" class="flex items-center gap-2 transition-colors {% if '/blog/' in page.url or '/posts/' in page.url or '/tags/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white " + ("" if ('/blog/' in page.url or '/posts/' in page.url or '/tags/' in page.url) else "opacity-0")) }}
            <span>Blog</span>
          </a>
        </div>
        <div>
          <a href="/resume/" class="flex items-center gap-2 transition-colors {% if '/resume/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white " + ("" if '/resume/' in page.url else "opacity-0")) }}
            <span>Resume</span>
          </a>
        </div>
        <div>
          <a href="/about/" class="flex items-center gap-2 transition-colors {% if '/about/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white " + ("" if '/about/' in page.url else "opacity-0")) }}
            <span>About</span>
          </a>
        </div>
        <div>
          <a href="/contact/" class="flex items-center gap-2 transition-colors {% if '/contact/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white " + ("" if '/contact/' in page.url else "opacity-0")) }}
            <span>Contact</span>
          </a>
        </div>
      </nav>

      <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800 space-y-2">
        <button type="button" 
                data-hs-overlay="#search-modal"
                class="flex items-center gap-2 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white text-xs w-full py-1 cursor-pointer">
          {{ icons.icon("search", "w-3.5 h-3.5 text-neutral-400") }}
          <span>Search (Ctrl+K)</span>
        </button>
        <a href="/feed.xml" class="flex items-center gap-2 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white text-xs py-1">
          {{ icons.icon("rss", "w-3.5 h-3.5 text-amber-500") }}
          <span>RSS Feed</span>
        </a>
      </div>
    </div>

    <div class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 pt-4 border-t border-neutral-100 dark:border-neutral-800">
      <p>Soumil Seal &middot; {{ "" | currentYear }}</p>
    </div>
  </div>

  <!-- Layout Wrapper: Persistent Side Navigation on Desktop + Centered Medium Width Column -->
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 w-full flex-grow flex justify-center">
    
    <!-- Primary Side Navigation Rail (Desktop & Tablet) -->
    <aside class="hidden md:block w-44 lg:w-48 shrink-0 pt-10 sm:pt-16 pr-6 lg:pr-8 sticky top-0 self-start text-xs font-normal no-print" aria-label="Primary Side Navigation">
      <nav class="space-y-2 mb-10">
        <div>
          <a href="/" class="flex items-center gap-1.5 transition-colors {% if page.url == '/' %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if page.url == '/' %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Home</span>
          </a>
        </div>
        <div>
          <a href="/projects/" class="flex items-center gap-1.5 transition-colors {% if '/projects/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/projects/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Projects</span>
          </a>
        </div>
        <div>
          <a href="/blog/" class="flex items-center gap-1.5 transition-colors {% if '/blog/' in page.url or '/posts/' in page.url or '/tags/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/blog/' in page.url or '/posts/' in page.url or '/tags/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Blog</span>
          </a>
        </div>
        <div>
          <a href="/resume/" class="flex items-center gap-1.5 transition-colors {% if '/resume/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/resume/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Resume</span>
          </a>
        </div>
        <div>
          <a href="/about/" class="flex items-center gap-1.5 transition-colors {% if '/about/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/about/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>About</span>
          </a>
        </div>
        <div>
          <a href="/contact/" class="flex items-center gap-1.5 transition-colors {% if '/contact/' in page.url %}font-semibold text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/contact/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Contact</span>
          </a>
        </div>

        <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800/80 space-y-2">
          <!-- Search in Side Navigation -->
          <button type="button" 
                  data-hs-overlay="#search-modal"
                  class="flex items-center gap-1.5 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors cursor-pointer w-full text-left"
                  title="Search articles and projects (Ctrl+K)">
            {{ icons.icon("search", "w-3 h-3 text-neutral-400") }}
            <span>Search</span>
            <kbd class="ml-auto font-mono text-[9px] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-400">Ctrl+K</kbd>
          </button>

          <!-- RSS Feed in Side Navigation -->
          <a href="/feed.xml" class="flex items-center gap-1.5 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors text-xs" title="RSS / Atom Feed">
            {{ icons.icon("rss", "w-3 h-3 text-neutral-400") }}
            <span>Feed</span>
          </a>
        </div>
      </nav>

      <!-- Side Rail Footer Note -->
      <div class="text-[11px] text-neutral-400 dark:text-neutral-500 space-y-1 leading-relaxed border-t border-neutral-100 dark:border-neutral-800/80 pt-4 font-mono">
        <p>Soumil Seal</p>
        <p>Personal engineering log.</p>
        <p>Build {{ "" | currentYear }}.</p>
      </div>
    </aside>

    <!-- Main Content Column: Uniform Medium Width (max-w-2xl ~ 672px) -->
    <main id="main-content" class="w-full max-w-2xl py-6 sm:py-10">
      {{ content | safe }}
    </main>

  </div>

  <!-- Search Modal -->
  {% include "components/search-modal.njk" %}

  <!-- Scripts -->
  <script src="/assets/js/preline.js"></script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/search.js"></script>
</body>
</html>
