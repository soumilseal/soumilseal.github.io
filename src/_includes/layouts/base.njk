{% import "components/icons.njk" as icons %}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">

  <!-- FOUC Prevention Script -->
  <script>
    (function () {
      try {
        const theme = localStorage.getItem('hs_theme') || localStorage.getItem('color-scheme');
        const isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = 'dark';
        }
      } catch (e) {}
    })();
  </script>

  <title>{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">

  <!-- Canonical and Feeds -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} Feed" href="/feed.xml">

  <!-- OpenGraph / Social Meta -->
  <meta property="og:title" content="{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title and title != site.name %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
  <meta name="twitter:description" content="{{ description or site.description }}">

  <!-- Typography: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Main CSS (Tailwind v4 + Preline UI) -->
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body class="bg-white text-neutral-900 antialiased dark:bg-[#0b0f19] dark:text-neutral-100 flex flex-col min-h-screen">
  <!-- Accessibility Skip Link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-neutral-900 text-white rounded-lg shadow-lg font-medium text-xs focus:outline-none dark:bg-white dark:text-black">
    Skip to main content
  </a>

  <!-- Layout Wrapper: Left Rail Navigation on Desktop + Medium Width Content Column -->
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 w-full flex-grow flex justify-center">
    
    <!-- Left Sticky Navigation Rail (Visible on Large Screens, matching Reference Layout) -->
    <aside class="hidden xl:block w-48 shrink-0 pt-16 pr-8 sticky top-0 self-start text-xs font-normal" aria-label="Desktop Side Navigation">
      <nav class="space-y-2 mb-10">
        <div>
          <a href="/" class="flex items-center gap-1.5 transition-colors {% if page.url == '/' %}font-medium text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if page.url == '/' %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Home</span>
          </a>
        </div>
        <div>
          <a href="/projects/" class="flex items-center gap-1.5 transition-colors {% if '/projects/' in page.url %}font-medium text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/projects/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Explore</span>
          </a>
        </div>
        <div>
          <a href="/about/" class="flex items-center gap-1.5 transition-colors {% if '/about/' in page.url %}font-medium text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/about/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Profile</span>
          </a>
        </div>
        <div>
          <a href="/blog/" class="flex items-center gap-1.5 transition-colors {% if '/blog/' in page.url or '/posts/' in page.url %}font-medium text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/blog/' in page.url or '/posts/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Posts</span>
          </a>
        </div>
        <div>
          <a href="/resume/" class="flex items-center gap-1.5 transition-colors {% if '/resume/' in page.url %}font-medium text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/resume/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Resume</span>
          </a>
        </div>
        <div>
          <a href="/contact/" class="flex items-center gap-1.5 transition-colors {% if '/contact/' in page.url %}font-medium text-neutral-900 dark:text-white{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white{% endif %}">
            {% if '/contact/' in page.url %}
              {{ icons.icon("caret-right-fill", "w-2.5 h-2.5 text-neutral-900 dark:text-white -ml-3") }}
            {% endif %}
            <span>Contact</span>
          </a>
        </div>
        <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800/80">
          <button type="button" 
                  data-hs-overlay="#search-modal"
                  class="flex items-center gap-1.5 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors cursor-pointer w-full text-left"
                  title="Search articles and projects (Ctrl+K)">
            {{ icons.icon("search", "w-3 h-3 text-neutral-400") }}
            <span>Search</span>
            <kbd class="ml-auto font-mono text-[9px] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-400">Ctrl+K</kbd>
          </button>
        </div>
      </nav>

      <!-- Side Rail Footer Note -->
      <div class="text-[11px] text-neutral-400 dark:text-neutral-500 space-y-1 leading-relaxed border-t border-neutral-100 dark:border-neutral-800/80 pt-4 font-mono">
        <p>Soumil Seal</p>
        <p>Personal engineering log.</p>
        <p>Build {{ "" | currentYear }}.</p>
      </div>
    </aside>

    <!-- Main Content Column: Fixed Medium Width (max-w-2xl ~ 672px) -->
    <main id="main-content" class="w-full max-w-2xl py-6 sm:py-10">
      {{ content | safe }}
    </main>

  </div>

  <!-- Search Modal -->
  {% include "components/search-modal.njk" %}

  <!-- Scripts -->
  <script src="/assets/js/preline.js"></script>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/search.js"></script>
</body>
</html>
