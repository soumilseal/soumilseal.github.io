{% import "components/icons.njk" as icons %}
<article
  class="project-item group relative bg-white dark:bg-neutral-950 hover:bg-neutral-50/90 dark:hover:bg-neutral-900/50 transition-colors cursor-pointer flex flex-col justify-between h-full before:absolute before:left-0 before:top-0 before:bottom-0 before:w-1 before:bg-primary-600 dark:before:bg-primary-500 before:opacity-0 group-hover:before:opacity-100 before:transition-opacity before:duration-200"
  data-category="{{ project.category }}"
>
  <div class="p-4 sm:p-5 flex flex-col justify-between h-full">
    <div>
      <div class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 mb-2">
        <span class="uppercase tracking-wider">{{ project.category }}</span>
      </div>

      <h3 class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors tracking-tight mb-2">
        <a
          href="{{ project.demo or project.github }}"
          target="_blank"
          rel="noopener noreferrer"
          class="focus:outline-none after:absolute after:inset-0 after:z-10"
        >
          {{ project.title }}
        </a>
      </h3>

      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans line-clamp-3 mb-4">
        {{ project.description }}
      </p>

      {% if project.tags %}
        <div class="flex flex-wrap gap-1.5 mb-4 text-[10px] font-mono text-neutral-400 dark:text-neutral-500">
          {% for tag in project.tags | head(3) %}
            <span class="px-1.5 py-0.5 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">#{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Minimal Action Links (relative z-20 so specific clicks work directly) -->
    <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between gap-2 text-xs font-mono relative z-20 mt-auto">
      <div class="flex items-center gap-3">
        {% if project.github %}
          <a
            href="{{ project.github }}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors py-0.5"
          >
            <span>source</span>
            {{ icons.icon("arrow-right", "w-3 h-3") }}
          </a>
        {% endif %}
        {% if project.demo %}
          <a
            href="{{ project.demo }}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-primary-600 dark:text-primary-400 hover:underline transition-colors py-0.5 font-medium"
          >
            <span>live demo</span>
            {{ icons.icon("arrow-up-right", "w-3 h-3") }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</article>
