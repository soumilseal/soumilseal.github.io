{% import "components/icons.njk" as icons %}

<article class="group relative flex flex-col py-6 border-b border-neutral-200/60 dark:border-neutral-800/60 last:border-b-0 transition-colors">
  <div class="flex items-center gap-3 text-xs text-neutral-400 dark:text-neutral-500 font-mono mb-2">
    <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    <span>&bull;</span>
    <span>{{ post.templateContent | readingTime }}</span>
    {% if post.data.featured %}
      <span class="text-accent-600 dark:text-accent-400 font-medium ml-auto">Featured</span>
    {% endif %}
  </div>

  <h3 class="text-lg sm:text-xl font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors tracking-tight mb-2">
    <a href="{{ post.url }}" class="focus:outline-none">
      <span class="absolute inset-0" aria-hidden="true"></span>
      {{ post.data.title }}
    </a>
  </h3>

  <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-3">
    {{ post.data.description }}
  </p>

  <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 dark:text-neutral-500 z-10">
    {% for tag in post.data.tags | filterTagList %}
      <a href="/tags/{{ tag | slugify }}/" class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">
        #{{ tag }}
      </a>
    {% endfor %}
  </div>
</article>
