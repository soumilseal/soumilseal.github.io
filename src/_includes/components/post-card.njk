{% import "components/icons.njk" as icons %}

<article class="post-item group relative flex flex-col p-6 sm:p-8 bg-white dark:bg-[#0a0a0a] hover:bg-neutral-50/80 dark:hover:bg-neutral-900/40 transition-colors">
  <div class="flex items-center gap-3 text-xs text-neutral-400 dark:text-neutral-500 font-mono mb-2.5">
    <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    <span>&bull;</span>
    <span>{{ post.templateContent | readingTime }}</span>
    {% if post.data.featured %}
      <span class="text-primary-600 dark:text-primary-400 font-medium ml-auto flex items-center gap-1">
        <span>Featured</span>
      </span>
    {% endif %}
  </div>

  <h3 class="text-lg sm:text-xl font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors tracking-tight mb-2">
    <a href="{{ post.url }}" class="focus:outline-none flex items-start justify-between gap-3">
      <span>{{ post.data.title }}</span>
      <span class="text-neutral-400 group-hover:text-primary-500 group-hover:translate-x-1 transition-all text-sm font-mono mt-0.5">&rarr;</span>
    </a>
  </h3>

  <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4 flex-grow font-sans">
    {{ post.data.description }}
  </p>

  <div class="flex items-center gap-2 pt-1 text-xs font-mono text-neutral-400 dark:text-neutral-500">
    {% for tag in post.data.tags | filterTagList %}
      <a href="/tags/{{ tag | slugify }}/" class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">
        #{{ tag }}
      </a>
    {% endfor %}
  </div>
</article>
