{% import "components/icons.njk" as icons %}
<article class="post-item group relative bg-white dark:bg-neutral-950 hover:bg-neutral-50/90 dark:hover:bg-neutral-900/50 transition-colors cursor-pointer before:absolute before:left-0 before:top-0 before:bottom-0 before:w-1 before:bg-primary-600 dark:before:bg-primary-500 before:opacity-0 group-hover:before:opacity-100 before:transition-opacity before:duration-200">
  <div class="p-5 sm:p-6 flex flex-col justify-center">
    <time
      datetime="{{ post.date | htmlDateString }}"
      class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500 mb-1.5 block"
    >
      {{ post.date | readableDate }}
    </time>

    <h3 class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors tracking-tight mb-1.5">
      <a href="{{ post.url }}" class="focus:outline-none after:absolute after:inset-0 after:z-10">
        {{ post.data.title }}
      </a>
    </h3>

    <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans line-clamp-2">
      {{ post.data.description }}
    </p>
  </div>
</article>
