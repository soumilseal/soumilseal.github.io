{% import "components/icons.njk" as icons %}

<div id="search-modal" class="hs-overlay hidden ti-modal fixed inset-0 z-50 overflow-x-hidden overflow-y-auto pointer-events-none p-4 sm:p-6 md:p-20" role="dialog" tabindex="-1" aria-labelledby="search-modal-label">
  <div class="hs-overlay-open:opacity-100 hs-overlay-open:duration-200 opacity-0 transition-all sm:max-w-2xl sm:w-full m-3 sm:mx-auto min-h-[calc(100%-3.5rem)] flex items-start">
    <div class="w-full flex flex-col bg-white dark:bg-[#111827] border border-neutral-200/90 dark:border-neutral-800 shadow-2xl rounded-2xl pointer-events-auto overflow-hidden">
      <!-- Modal Header -->
      <div class="flex justify-between items-center py-3.5 px-4 sm:px-5 border-b border-neutral-200/80 dark:border-neutral-800">
        <h3 id="search-modal-label" class="font-semibold text-neutral-800 dark:text-neutral-100 flex items-center gap-2 text-sm">
          {{ icons.icon("search", "w-4 h-4 text-accent-500") }}
          <span>Search articles &amp; projects</span>
        </h3>
        <button type="button" class="size-8 inline-flex justify-center items-center gap-x-2 rounded-lg border border-transparent bg-neutral-100 text-neutral-600 hover:bg-neutral-200 focus:outline-none dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:text-neutral-300 transition-colors text-xs cursor-pointer" aria-label="Close" data-hs-overlay="#search-modal">
          <span class="sr-only">Close</span>
          {{ icons.icon("x", "w-4 h-4") }}
        </button>
      </div>

      <!-- Modal Body (Pagefind UI mount point) -->
      <div class="p-4 sm:p-5 overflow-y-auto max-h-[65vh]">
        <div id="pagefind-search"></div>
      </div>

      <!-- Modal Footer -->
      <div class="flex justify-between items-center py-3 px-4 sm:px-5 bg-neutral-50 dark:bg-neutral-900/90 border-t border-neutral-200/80 dark:border-neutral-800 text-xs text-neutral-500 dark:text-neutral-400 font-mono">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 bg-neutral-200/80 dark:bg-neutral-800 rounded text-[10px]">ESC</kbd>
            <span>to close</span>
          </span>
          <span class="flex items-center gap-1">
            <kbd class="px-1.5 py-0.5 bg-neutral-200/80 dark:bg-neutral-800 rounded text-[10px]">Ctrl</kbd>
            <kbd class="px-1.5 py-0.5 bg-neutral-200/80 dark:bg-neutral-800 rounded text-[10px]">K</kbd>
            <span>shortcut</span>
          </span>
        </div>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-500">Indexed with Pagefind</span>
      </div>
    </div>
  </div>
</div>
