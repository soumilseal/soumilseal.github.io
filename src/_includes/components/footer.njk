{% import "components/icons.njk" as icons %}

<footer class="mt-auto border-t border-neutral-200/80 dark:border-neutral-800/80 transition-colors bg-white dark:bg-[#160606]">
  <div class="max-w-3xl mx-auto px-6 sm:px-8 py-16 sm:py-20 border-x border-neutral-200/80 dark:border-neutral-800/80 relative space-y-8 bg-white dark:bg-[#160606]">
    <!-- Vercel Gridline Intersection Pluses -->
    {{ icons.vercel_plus("tl") }}
    {{ icons.vercel_plus("tr") }}
    {{ icons.vercel_plus("bl") }}
    {{ icons.vercel_plus("br") }}

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 text-sm text-neutral-500 dark:text-neutral-400">
      
      <!-- Brand & Description -->
      <div class="space-y-1">
        <p class="font-medium text-neutral-900 dark:text-neutral-100">Soumil Seal</p>
        <p class="text-xs text-neutral-400 dark:text-neutral-500 font-mono">Developer & BCA Student</p>
      </div>

      <!-- Quick Text Links -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono">
        <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          GitHub
        </a>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          LinkedIn
        </a>
        <a href="{{ site.twitter }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          Twitter/X
        </a>
        <a href="mailto:{{ site.email }}" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          Email
        </a>
        <a href="/feed.xml" class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          RSS
        </a>
      </div>

    </div>

    <!-- Bottom line with Gridline divider -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-neutral-400 dark:text-neutral-500 font-mono text-[11px] pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80">
      <p>© {{ "" | currentYear }} Soumil Seal. All rights reserved.</p>
      <p>Eleventy &bull; Tailwind CSS &bull; Pagefind</p>
    </div>
  </div>
</footer>
