{% import "components/icons.njk" as icons %}

{% if pagination.pages.length > 1 %}
  <nav
    aria-label="Pagination Navigation"
    class="border-b border-neutral-300 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-900/40 px-4 sm:px-6 py-1.5 flex items-center justify-between text-xs font-mono"
  >
    <!-- Previous Link -->
    <div>
      {% if pagination.href.previous %}
        <a
          href="{{ pagination.href.previous }}"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-950 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-800 dark:text-neutral-200 transition-colors"
          aria-label="Previous Page"
        >
          {{ icons.icon("arrow-left", "w-3 h-3") }}
          <span>prev/</span>
        </a>
      {% else %}
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-neutral-200 dark:border-neutral-800/60 bg-neutral-100/50 dark:bg-neutral-900/30 text-neutral-400 dark:text-neutral-600 cursor-not-allowed select-none"
          aria-disabled="true"
        >
          {{ icons.icon("arrow-left", "w-3 h-3") }}
          <span>prev/</span>
        </span>
      {% endif %}
    </div>

    <!-- Page Counter & Numbers -->
    <div class="flex items-center gap-1.5">
      <span
        class="text-neutral-400 dark:text-neutral-500 mr-2 hidden sm:inline"
      >
        page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}
      </span>

      {% for pageHref in pagination.hrefs %}
        {% if loop.index0 == pagination.pageNumber %}
          <span
            aria-current="page"
            class="size-7 inline-flex items-center justify-center bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 font-bold"
          >
            {{ loop.index }}
          </span>
        {% else %}
          <a
            href="{{ pageHref }}"
            class="size-7 inline-flex items-center justify-center border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-950 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-colors"
          >
            {{ loop.index }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Next Link -->
    <div>
      {% if pagination.href.next %}
        <a
          href="{{ pagination.href.next }}"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-950 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-800 dark:text-neutral-200 transition-colors"
          aria-label="Next Page"
        >
          <span>next/</span>
          {{ icons.icon("arrow-right", "w-3 h-3") }}
        </a>
      {% else %}
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-neutral-200 dark:border-neutral-800/60 bg-neutral-100/50 dark:bg-neutral-900/30 text-neutral-400 dark:text-neutral-600 cursor-not-allowed select-none"
          aria-disabled="true"
        >
          <span>next/</span>
          {{ icons.icon("arrow-right", "w-3 h-3") }}
        </span>
      {% endif %}
    </div>
  </nav>
{% endif %}
