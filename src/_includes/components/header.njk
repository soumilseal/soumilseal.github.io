{% import "components/icons.njk" as icons %}

<header class="w-full bg-neutral-50/80 dark:bg-[#0b0f19]/80 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-3xl mx-auto px-6 sm:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo / Name -->
      <a href="/" class="group flex items-center gap-2 font-medium text-neutral-900 dark:text-neutral-100 text-sm tracking-tight focus:outline-none" aria-label="Soumil Seal homepage">
        <span class="font-bold tracking-tight text-base group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
          Soumil Seal
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Primary Navigation">
        {% for item in site.nav %}
          {% set isActive = (page.url == item.url) or (item.url != "/" and item.url in page.url) %}
          <a href="{{ item.url }}" 
             class="text-sm transition-colors focus:outline-none {% if isActive %}text-neutral-900 dark:text-neutral-100 font-semibold{% else %}text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100{% endif %}"
             {% if isActive %}aria-current="page"{% endif %}>
            {{ item.text }}
          </a>
        {% endfor %}
      </nav>

      <!-- Utility Actions (Search, Theme Toggle) -->
      <div class="flex items-center gap-3">
        <!-- Search Trigger -->
        <button type="button" 
                class="p-2 rounded-lg text-neutral-400 hover:text-neutral-900 dark:text-neutral-500 dark:hover:text-neutral-200 transition-colors focus:outline-none" 
                aria-haspopup="dialog" 
                aria-expanded="false" 
                aria-controls="search-modal" 
                data-hs-overlay="#search-modal"
                title="Search (Ctrl+K)">
          {{ icons.icon("search", "w-4 h-4") }}
        </button>

        <!-- Theme Toggle -->
        <button type="button" 
                class="theme-toggle-btn p-2 rounded-lg text-neutral-400 hover:text-neutral-900 dark:text-neutral-500 dark:hover:text-neutral-200 transition-colors focus:outline-none" 
                aria-label="Toggle theme">
          <span class="dark:hidden">
            {{ icons.icon("moon", "w-4 h-4") }}
          </span>
          <span class="hidden dark:inline">
            {{ icons.icon("sun", "w-4 h-4") }}
          </span>
        </button>

        <!-- Mobile Menu Toggle Button -->
        <div class="md:hidden">
          <button type="button" 
                  class="hs-collapse-toggle p-2 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors focus:outline-none" 
                  id="hs-navbar-collapse" 
                  aria-expanded="false" 
                  aria-controls="mobile-nav" 
                  aria-label="Toggle mobile menu" 
                  data-hs-collapse="#mobile-nav">
            <span class="hs-collapse-open:hidden">
              {{ icons.icon("menu", "w-5 h-5") }}
            </span>
            <span class="hs-collapse-open:block hidden">
              {{ icons.icon("x", "w-5 h-5") }}
            </span>
          </button>
        </div>
      </div>

    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-nav" class="hs-collapse hidden overflow-hidden transition-all duration-300 md:hidden pb-4" aria-labelledby="hs-navbar-collapse">
      <nav class="flex flex-col gap-3 pt-2" aria-label="Mobile Navigation">
        {% for item in site.nav %}
          {% set isActive = (page.url == item.url) or (item.url != "/" and item.url in page.url) %}
          <a href="{{ item.url }}" 
             class="text-sm py-1 transition-colors {% if isActive %}text-neutral-900 dark:text-white font-semibold{% else %}text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white{% endif %}"
             {% if isActive %}aria-current="page"{% endif %}>
            {{ item.text }}
          </a>
        {% endfor %}
      </nav>
    </div>

  </div>
</header>
