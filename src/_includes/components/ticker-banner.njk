{% import "components/icons.njk" as icons %}

{% if site.ticker and site.ticker.enabled !== false %}
  <!-- System Status Ticker Banner (Dismissible) -->
  <div
    id="system-ticker-banner"
    class="w-full transition-all duration-200"
  >
    <div class="max-w-[950px] mx-auto px-4 py-1.5 bg-neutral-950 text-sky-400 font-mono text-[11px] border-x border-b border-neutral-300 dark:border-neutral-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="tracking-tight font-medium flex items-center gap-1.5">
          <span>{{ site.ticker.text or 'soumilseal2026-systems-in/' }}</span>
        </span>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-[10px] text-neutral-400 font-mono hidden sm:inline">
          {{ site.ticker.runtime or 'runtime: node // bca student // india' }}
        </div>

        <!-- Close / Dismiss Button -->
        <button
          type="button"
          id="close-ticker-btn"
          class="text-neutral-500 hover:text-white transition-colors p-0.5 focus:outline-none flex items-center justify-center cursor-pointer"
          aria-label="Close banner"
          title="Close banner"
        >
          {{ icons.icon("x", "w-3 h-3") }}
        </button>
      </div>
    </div>
  </div>
{% endif %}

<script>
(function() {
  const closeBtn = document.getElementById("close-ticker-btn");
  const banner = document.getElementById("system-ticker-banner");
  if (closeBtn && banner) {
    closeBtn.addEventListener("click", function() {
      banner.style.display = "none";
      try {
        localStorage.setItem("hide_ticker_banner", "true");
        document.documentElement.classList.add("hide-ticker");
      } catch (e) {}
    });
  }
})();
</script>
